rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isOwner(eventId) {
      return request.auth != null &&
        request.auth.uid == get(/databases/$(database)/documents/events/$(eventId)).data.ownerId;
    }

    function isCoOrganizer(eventId) {
      return isCoOrganizerData(get(/databases/$(database)/documents/events/$(eventId)).data);
    }

    function isOwnerOrCoOrg(eventId) {
      return isOwner(eventId) || isCoOrganizer(eventId);
    }

    // Modelo unificado de colaboradores (Fase 3 de ROLES_PERMISSIONS_REDESIGN.md)
    // — event.collaborators[uid] = { role, permissionOverrides?, ... },
    // reemplazo futuro de coOrganizersMap+coOrganizerPermissions+
    // concessions.concessionsStaffMap. Convive con los tres mapas legacy
    // durante la migración (se leen en paralelo, nunca se escribe acá desde
    // reglas — solo Cloud Functions con Admin SDK, ver collaboratorInvites
    // más abajo).
    function collaboratorEntry(evData) {
      return evData.get('collaborators', {}).get(request.auth.uid, null);
    }

    // Mismos presets que COLLABORATOR_ROLE_PRESETS (src/types/collaboratorPermissions.ts)
    // y ROLE_PRESETS (functions/src/lib/permissions.ts) — cuarta copia manual
    // del mismo criterio (rules no puede importar código, mismo motivo que el
    // resto de las constantes duplicadas de este archivo). 'administrador' se
    // resuelve aparte como acceso total en collaboratorPermValue() de abajo,
    // no necesita entrada acá.
    function collaboratorRolePreset(role) {
      return role == 'recepcion' ? {'viewGuestList': true, 'scanQr': true, 'postWall': true, 'viewPayments': true}
        : role == 'caja' ? {'postWall': true, 'viewPayments': true, 'confirmPayments': true, 'viewCatalog': true, 'viewSales': true, 'viewOrders': true}
        : role == 'ventas' ? {'postWall': true, 'manageConcessions': true, 'viewCatalog': true, 'viewSales': true, 'viewOrders': true}
        : role == 'preparacion' ? {'postWall': true, 'viewCatalog': true, 'viewOrders': true, 'prepareOrders': true}
        : {};
    }

    // Resuelve el valor de UN permiso para una entrada ya confirmada de
    // event.collaborators (no null) — separado de coOrgPerm/coOrgPermData
    // porque ahí todavía hace falta decidir si cae acá o al sistema legacy.
    function collaboratorPermValue(entry, key) {
      return entry.get('permissionOverrides', {}).get(
        key,
        entry.get('role', '') == 'administrador' ? true : collaboratorRolePreset(entry.get('role', '')).get(key, false)
      );
    }

    // Permiso granular de un colaborador (ver src/types/coOrganizerPermissions.ts
    // y src/types/collaboratorPermissions.ts). `def` es el default LEGACY para
    // ese permiso — debe coincidir con LEGACY_COORG_DEFAULTS, así un
    // co-organizador agregado antes de que existiera coOrganizerPermissions
    // (o antes de que existiera este permiso puntual) conserva el mismo
    // acceso amplio que ya tenía. Prioridad: event.collaborators (nuevo, si
    // existe una entrada) → coOrganizerPermissions (legacy).
    function coOrgPerm(eventId, key, def) {
      return coOrgPermData(get(/databases/$(database)/documents/events/$(eventId)).data, key, def);
    }

    // El dueño siempre puede; un co-organizador puede si tiene ese permiso
    // (o no tiene entrada en coOrganizerPermissions y `def` es true). Único
    // punto de la app que decide "¿puede este usuario hacer X en este
    // evento?" — cada `allow` de acá abajo llama a esto en vez de reimplementar
    // la misma comparación.
    function canDo(eventId, key, def) {
      return isOwner(eventId) || (isCoOrganizer(eventId) && coOrgPerm(eventId, key, def));
    }

    // Variantes de isOwner/isCoOrganizer/coOrgPerm/canDo para usar SOLO
    // dentro de `match /events/{eventId}` (su `allow update`/`allow
    // delete`) — ahí `resource.data` YA ES el documento del evento, así que
    // llamar a isOwner(eventId)/canDo(eventId,...) reevalúa un get() al
    // MISMO documento que la regla ya tiene servido sin costo. Con varias
    // ramas en esa única regla `allow update` (cada una llamando canDo, que
    // a su vez llama isOwner+isCoOrganizer+coOrgPerm, cada una con su propio
    // get()), el evaluador de reglas llegó a rechazar escrituras totalmente
    // ajenas a coanfitriones (ej. el autoregistro público) con "maximum of
    // 1000 expressions to evaluate" — no por exceso de LECTURAS (Firestore
    // cachea los get() al mismo path dentro de una misma evaluación) sino
    // por exceso de EVALUACIONES DE EXPRESIÓN de la regla entera. Estas
    // variantes leen directo de `evData` (ya en mano) en vez de volver a
    // pedir el documento — mismo resultado, sin la llamada a get() extra.
    function isOwnerData(evData) {
      return request.auth != null && request.auth.uid == evData.ownerId;
    }

    function isCoOrganizerData(evData) {
      return request.auth != null &&
        ((evData.coOrganizersMap != null && request.auth.uid in evData.coOrganizersMap) ||
         collaboratorEntry(evData) != null);
    }

    function coOrgPermData(evData, key, def) {
      let collab = collaboratorEntry(evData);
      return collab != null
        ? collaboratorPermValue(collab, key)
        : evData.get('coOrganizerPermissions', {}).get(request.auth.uid, {}).get(key, def);
    }

    function canDoData(evData, key, def) {
      return isOwnerData(evData) || (isCoOrganizerData(evData) && coOrgPermData(evData, key, def));
    }

    // Para usar canDoData/companionsWithinLimitData FUERA de
    // `match /events/{eventId}` (ej. dentro de `match /guests/{guestId}`,
    // donde no hay un `resource.data` de evento gratis) sin repetir el path
    // completo del get() en cada call site. Nota: Firestore Rules no permite
    // `let` a nivel de match block (solo dentro de funciones), así que esto
    // sigue siendo un get() por cada llamada — pero UNO solo (cacheado por
    // path), en vez de los 3 get()s encadenados que dispara canDo() vía
    // isOwner+isCoOrganizer+coOrgPerm.
    function eventDataFor(eventId) {
      return get(/databases/$(database)/documents/events/$(eventId)).data;
    }

    // Admin = tener el custom claim `admin: true` en el token, sincronizado
    // por functions/src/triggers/onAdminWritten.ts cada vez que se crea/borra
    // un documento en /admins/{uid} (FIRESTORE_RULES_SIMPLIFICATION_AUDIT.md
    // Fase C). El claim evita la lectura extra de Firestore que antes hacía
    // esta función en más de 20 ramas del archivo — una de las dos causas ya
    // documentadas de haber excedido el límite de 1000 expresiones (ver
    // comentario de canDoData más abajo).
    //
    // El `exists(...)` se conserva como red de seguridad TRANSICIONAL, no
    // como mecanismo final: cubre admins que ya existían antes de este
    // trigger y todavía no corrieron scripts/backfill-admin-claims.mjs, y
    // cualquier sesión activa que no haya refrescado su ID token todavía
    // (hasta 1h de desfase natural). Retirar esta rama es un paso aparte,
    // después de confirmar en producción que todos los admins actuales ya
    // tienen el claim — no lo hagas sin esa confirmación.
    //
    // Agregar/quitar admins se sigue haciendo a mano desde la consola de
    // Firebase (Firestore → admins), nunca desde la app: ver `allow write: if
    // false` en el match de abajo.
    function isAdmin() {
      return request.auth != null && (
        request.auth.token.get('admin', false) == true ||
        exists(/databases/$(database)/documents/admins/$(request.auth.uid))
      );
    }

    // Evita crear un evento con `requiresPayment: true` y precio 0/ausente —
    // el cliente ya bloquea esto antes de enviar (ver EventCreate.tsx/
    // canProceedStep y EditEventForm.tsx/handleReviewSubmit), esta es la
    // barrera real si alguien habla directo contra Firestore. Solo se aplica
    // en `create`: en `update` el dueño ya tiene control total sobre su
    // propio evento (ver `allow update` más abajo) y la misma pantalla de
    // edición pasa por el mismo guard cliente.
    function isValidEventPricing() {
      let d = request.resource.data;
      return !d.requiresPayment || (d.ticketPrice is number && d.ticketPrice > 0);
    }

    // EventData.maxCompanions (StepInvitationMethod/EditEventForm): tope de
    // acompañantes por invitado individual, 0-20 — debe coincidir con
    // GUEST_MAX_COMPANIONS en src/utils/validation.ts. Mismo criterio que
    // isValidEventPricing: solo se valida en `create`, en `update` el dueño
    // ya tiene control total sobre su propio evento.
    function isValidMaxCompanions() {
      let d = request.resource.data;
      return !('maxCompanions' in d)
        || (d.maxCompanions is number && d.maxCompanions >= 0 && d.maxCompanions <= 20);
    }

    // Techo de cantidad para 3 arrays/mapas del evento que antes no tenían
    // ningún límite server-side (solo disciplina del organizador): definían
    // un riesgo de documento gigante sin barrera real, ya que un cliente que
    // hable directo contra Firestore podía ignorar por completo los límites
    // de UI (TimelineEditor/CustomFieldsBuilder/useCoOrganizers). Debe
    // coincidir con EVENT_CUSTOM_FIELDS_MAX_COUNT/EVENT_TIMELINE_MAX_ENTRIES/
    // EVENT_CO_ORGANIZERS_MAX en src/utils/validation.ts. Se evalúa sobre el
    // documento resultante completo (no un delta), así que una escritura que
    // no toca estos campos sigue pasando trivialmente (quedan como estaban).
    function eventContentCapsOk() {
      let d = request.resource.data;
      return d.get('customFields', []).size() <= 30
        && d.get('timeline', []).size() <= 20
        && d.get('coOrganizersMap', {}).size() <= 20
        && d.get('collaborators', {}).size() <= 20
        && d.get('faq', []).size() <= 20
        && d.get('transport', {}).get('options', []).size() <= 20
        && d.get('transport', {}).get('specialInstructions', []).size() <= 20
        && d.get('reminderRules', []).size() <= 5;
    }

    // Gate de beta del módulo de venta de comida/bebida durante el evento
    // (ver FOOD_BEVERAGE_ORDERING_ARCHITECTURE.md). Mientras dure la beta,
    // solo un isAdmin() puede pasar `concessions.enabled` de `false` a
    // `true` — apagarlo (true → false) lo puede hacer cualquier dueño, sin
    // necesitar ser admin, igual que cualquier otro campo de configuración
    // del evento. Pasar a GA (apertura pública) es reemplazar `isAdmin()`
    // acá por `canDoData(newEv, 'manageConcessions', false)`, sin tocar el
    // resto de este archivo ni migrar datos.
    function concessionsEnableChangeIsAllowed(oldEv, newEv) {
      let wasEnabled = oldEv.get('concessions', {}).get('enabled', false);
      let willBeEnabled = newEv.get('concessions', {}).get('enabled', false);
      return willBeEnabled == wasEnabled || willBeEnabled == false || isAdmin();
    }

    // Valida el delta de un contador de "gente adentro" (checkedInCount /
    // occupancyCount): sin cambios, o +-1..50 en cualquier dirección —
    // walkIn/walkOut mueven de a 1 (Opción A/C, sin acompañantes), mientras
    // que checkInGuest/checkOutGuest mueven partySize() (invitado +
    // acompañantes) de una sola vez, en cualquiera de los dos sentidos según
    // sea una entrada o una salida. El tope de 50 no se ata a un límite
    // exacto de acompañantes que la UI no impone.
    function counterDeltaOk(newVal, oldVal) {
      return newVal == oldVal
        || (newVal < oldVal && newVal >= oldVal - 50)
        || (newVal > oldVal && newVal <= oldVal + 50);
    }

    // Límite duro y opcional de asistentes (ver CAPACITY_LIMIT_ARCHITECTURE.md
    // y assertCapacityAvailable en src/firebase/attendeeLimit.ts). Red de
    // seguridad, no la garantía principal: la garantía real de "nunca
    // 201/200" la da la runTransaction del cliente (Firestore reintenta
    // automáticamente la que pierde un conflicto de versión contra el mismo
    // documento) — esto solo cierra la puerta a un cliente que evite esa
    // transacción y escriba peopleCount directo. Solo se evalúa cuando el
    // evento tiene el límite activado; con attendeeLimitEnabled ausente/false
    // (todo evento antes de esta feature) siempre da true, sin excepción.
    // Las bajas de peopleCount SIEMPRE están permitidas, sin importar el
    // límite — solo se bloquean los aumentos que superarían capacity.
    function attendeeLimitOk(oldEv, newEv) {
      return !(oldEv.get('attendeeLimitEnabled', false) == true)
        || newEv.peopleCount <= oldEv.peopleCount
        || newEv.peopleCount <= oldEv.get('capacity', 0);
    }

    // rsvpYesCount/rsvpNoCount/rsvpPendingCount (auditoría F22): a diferencia
    // del resto de los contadores del evento, ESTE lo escribe directamente
    // el invitado sin cuenta desde su propio pase (setGuestRsvp/
    // resetGuestRsvp en src/firebase/guests.ts) — no hay canDo()/scanQr que
    // exigir acá. La barrera real es esta función: exige que la SUMA de los
    // 3 se mantenga igual (un RSVP solo MUEVE un invitado de un balde a
    // otro, nunca crea ni destruye uno) y acota cada delta individual con el
    // mismo margen que counterDeltaOk — cierra la puerta a que un cliente
    // hablando directo con Firestore infle cualquiera de los 3 sin una resta
    // compensatoria en otro.
    function rsvpCountsOk(oldEv, newEv) {
      return (newEv.get('rsvpYesCount', 0) + newEv.get('rsvpNoCount', 0) + newEv.get('rsvpPendingCount', 0))
          == (oldEv.get('rsvpYesCount', 0) + oldEv.get('rsvpNoCount', 0) + oldEv.get('rsvpPendingCount', 0))
        && counterDeltaOk(newEv.get('rsvpYesCount', 0), oldEv.get('rsvpYesCount', 0))
        && counterDeltaOk(newEv.get('rsvpNoCount', 0), oldEv.get('rsvpNoCount', 0))
        && counterDeltaOk(newEv.get('rsvpPendingCount', 0), oldEv.get('rsvpPendingCount', 0));
    }

    // Autocancelación ("Cancelar mi asistencia", GuestPass.tsx, invitado con
    // rsvpStatus 'yes' que decide no ir) — a diferencia de rsvpCountsOk (que
    // solo MUEVE un invitado entre baldes), acá el invitado se borra entero:
    // el total baja en 1. Sin gate de canDo, mismo criterio que la rama de
    // RSVP de arriba: lo dispara el invitado sin cuenta desde su propio pase.
    // checkedInCount/occupancyCount deben quedar exactamente iguales — es la
    // defensa (del lado del contador) de la misma regla de negocio que
    // guests/{guestId} `allow delete` exige del lado del documento borrado:
    // si ya hizo check-in, no puede autocancelarse. peopleCount acotado a
    // 1..21 (mismo techo que 1 + GUEST_MAX_COMPANIONS ya usado en la rama de
    // autoregistro) porque una autocancelación es siempre de UN invitado
    // (nunca en lote, a diferencia del borrado del organizador). paidCount
    // solo puede bajar 0 (no había pagado) o exactamente lo mismo que
    // peopleCount (pago es todo-o-nada por invitado, nunca parcial).
    function guestSelfCancelCountsOk(oldEv, newEv) {
      return newEv.get('guestCount', 0) == eventGuestCountBefore(oldEv) - 1
        && newEv.get('peopleCount', 0) <= eventPeopleCountBefore(oldEv) - 1
        && newEv.get('peopleCount', 0) >= eventPeopleCountBefore(oldEv) - 21
        && newEv.get('checkedInCount', 0) == oldEv.get('checkedInCount', 0)
        && newEv.get('occupancyCount', 0) == oldEv.get('occupancyCount', 0)
        && (
          newEv.get('paidCount', 0) == oldEv.get('paidCount', 0)
          || (oldEv.get('paidCount', 0) - newEv.get('paidCount', 0)) == (eventPeopleCountBefore(oldEv) - newEv.get('peopleCount', 0))
        )
        && (oldEv.get('rsvpYesCount', 0) - newEv.get('rsvpYesCount', 0)) in [0, 1]
        && (oldEv.get('rsvpNoCount', 0) - newEv.get('rsvpNoCount', 0)) in [0, 1]
        && (oldEv.get('rsvpPendingCount', 0) - newEv.get('rsvpPendingCount', 0)) in [0, 1]
        && ((oldEv.get('rsvpYesCount', 0) - newEv.get('rsvpYesCount', 0))
            + (oldEv.get('rsvpNoCount', 0) - newEv.get('rsvpNoCount', 0))
            + (oldEv.get('rsvpPendingCount', 0) - newEv.get('rsvpPendingCount', 0))) == 1;
    }

    // reactionCount/reactionCountsByType (auditoría F2/F11, migración de
    // `reactions{}` embebido a subcolección): a diferencia de
    // counterDeltaOk (margen de 50, pensado para altas en lote como
    // addGuestsBulk), UNA reacción real (reactToContent, src/firebase/
    // interactions.ts) solo puede mover el total en como mucho 1 de una vez
    // (reaccionar, quitar reacción, o cambiar de tipo — que no mueve el
    // total, solo resta 1 de un tipo y suma 1 en otro) — un margen más
    // grande dejaría que un cliente hablando directo contra Firestore
    // infle el conteo sin pasar por la subcolección, justo lo que esta
    // migración busca evitar.
    function reactionCounterDeltaOk(newVal, oldVal) {
      return newVal == oldVal
        || (newVal < oldVal && newVal >= oldVal - 1)
        || (newVal > oldVal && newVal <= oldVal + 1);
    }

    // Tipos cerrados (ver ReactionType en src/types/index.ts) — se validan
    // por nombre fijo, no iterando el mapa, mismo criterio que rsvpCountsOk
    // con sus 3 campos fijos.
    function reactionCountsByTypeOk(oldEv, newEv) {
      let oldCounts = oldEv.get('reactionCountsByType', {});
      let newCounts = newEv.get('reactionCountsByType', {});
      return newCounts.diff(oldCounts).affectedKeys().size() <= 2
        && reactionCounterDeltaOk(newCounts.get('like', 0), oldCounts.get('like', 0))
        && reactionCounterDeltaOk(newCounts.get('love', 0), oldCounts.get('love', 0))
        && reactionCounterDeltaOk(newCounts.get('haha', 0), oldCounts.get('haha', 0))
        && reactionCounterDeltaOk(newCounts.get('wow', 0), oldCounts.get('wow', 0))
        && reactionCounterDeltaOk(newCounts.get('sad', 0), oldCounts.get('sad', 0))
        && reactionCounterDeltaOk(newCounts.get('angry', 0), oldCounts.get('angry', 0));
    }

    function reactionCountOk(oldEv, newEv) {
      return reactionCounterDeltaOk(newEv.get('reactionCount', 0), oldEv.get('reactionCount', 0));
    }

    // Doc espejo de una reacción en events/{eventId}/{wall|photos}/{id}/
    // reactions/{token} — mismas validaciones de contenido que ya existían
    // para el valor dentro del mapa `reactions` (nunca se habían escrito
    // acá, porque el mapa completo no se valida campo por campo, solo su
    // tamaño). El mismo límite de identidad ya documentado (reacciones
    // anónimas, sin request.auth.uid detrás) sigue aplicando: cualquiera que
    // conozca un token puede crear/actualizar/borrar ESE documento — ni
    // mejor ni peor que hoy, donde cualquiera que conozca un token puede
    // escribir esa misma clave del mapa.
    function isValidReactionDoc() {
      let d = request.resource.data;
      return d.type in ['like', 'love', 'haha', 'wow', 'sad', 'angry']
        && d.name is string && d.name.size() > 0 && d.name.size() <= 60
        && (!('photoURL' in d) || (d.photoURL is string && d.photoURL.size() <= 500));
    }

    // Cualquier cliente puede crear mensajes del muro sin autenticarse —
    // estos límites son la última barrera real si alguien evita por completo
    // la capa de aplicación (src/firebase/wall.ts) y escribe directo contra
    // Firestore. Deben coincidir con src/utils/validation.ts.
    // authorRole/postWall: antes `authorRole` no se validaba en absoluto acá
    // (isValidWallReply sí lo restringía a ['owner','guest'], pero un mensaje
    // NUEVO no) — el cliente decide localmente si postea como 'owner'
    // (EventWall.tsx compara uid contra event.ownerId), sin nada del lado
    // servidor que lo confirme. Cualquiera hablando directo contra Firestore
    // podía postear como 'owner' y suplantar al organizador. `postWall`
    // (permiso de coanfitrión, ver src/types/coOrganizerPermissions.ts)
    // tampoco se aplicaba en ningún lado — el toggle del editor no tenía
    // efecto real. Solo alcanza a coanfitriones: el dueño nunca está en
    // coOrganizersMap (isCoOrganizer da false) y un invitado sin sesión
    // tampoco (requiere request.auth).
    function isValidWallMessage(eventId) {
      let d = request.resource.data;
      return d.text is string && d.text.size() > 0 && d.text.size() <= 500
        && d.type in ['comment', 'question', 'music', 'idea']
        && d.authorName is string && d.authorName.size() > 0 && d.authorName.size() <= 60
        && d.authorToken is string && d.authorToken.size() <= 100
        && d.authorRole in ['owner', 'guest']
        && (d.authorRole == 'guest' || isOwner(eventId))
        && (!isCoOrganizer(eventId) || coOrgPerm(eventId, 'postWall', true));
    }

    // Misma validación que isValidWallMessage, para el elemento agregado al
    // array `replies` (ver isValidWallReplyAppend más abajo). authorRole no
    // se restringe a 'guest' — el anfitrión responde con este mismo flujo,
    // no uno aparte.
    function isValidWallReply(r, eventId) {
      return r.text is string && r.text.size() > 0 && r.text.size() <= 500
        && r.authorName is string && r.authorName.size() > 0 && r.authorName.size() <= 60
        && r.authorToken is string && r.authorToken.size() <= 100
        && r.authorRole in ['owner', 'guest']
        // Mismo chequeo de suplantación que isValidWallMessage: solo el
        // dueño real puede quedar marcado 'owner' en su propia respuesta.
        && (r.authorRole == 'guest' || isOwner(eventId));
    }

    // Cualquier participante autorizado del muro puede agregar una respuesta
    // (misma autorización que crear un mensaje nuevo: no bloqueado por
    // sanción). Solo permite AGREGAR un elemento al final del array —
    // request.resource.data.replies[0:N] == resource.data.replies exige que
    // las respuestas ya existentes lleguen sin tocar, para que un cliente no
    // pueda reescribir o borrar respuestas ajenas aprovechando este permiso.
    //
    // Reutilizada también por `photos` (ver match /photos/{photoId} más
    // abajo) — responder a una foto o a una "historia" (que es la misma foto
    // vista agrupada, ver StoriesBar.tsx) pasa por esta misma función, sin
    // duplicar su lógica. oldReplies tolera un documento sin el campo
    // `replies` (fotos subidas antes de esta función, que nunca lo
    // escribieron) tratándolo como lista vacía — así no hace falta
    // backfillear ninguna foto ya existente para que pueda recibir su
    // primera respuesta.
    function isValidWallReplyAppend(eventId) {
      let oldReplies = resource.data.get('replies', []);
      let newReplies = request.resource.data.replies;
      return (request.auth == null || !commentsBlocked(eventId))
        && newReplies.size() == oldReplies.size() + 1
        && newReplies.size() <= 500
        // oldReplies.size() == 0 evita el slice newReplies[0:0]: sin
        // respuestas previas no hay nada que preservar, y ese slice vacío
        // dispara un error de evaluación del motor de reglas (visto en el
        // emulador al probar la primera respuesta de una foto legacy sin
        // `replies`, ver isValidWallReplyAppend arriba) en vez de devolver
        // limpiamente una lista vacía.
        && (oldReplies.size() == 0 || newReplies[0:oldReplies.size()] == oldReplies)
        && isValidWallReply(newReplies[oldReplies.size()], eventId);
    }

    // Alta pública en la lista de espera (WAITLIST_RECONFIRMATION_ARCHITECTURE.md).
    // Reemplaza el bloque `match /waitlist/{entryId}` que existía más abajo
    // (huérfano desde que se eliminó el sistema de reserva/hold — ver el
    // comentario que tenía, "no hay ningún camino que lleve a un invitado a
    // esperar cupo"): ahora sí lo hay, porque el límite duro de asistentes
    // (attendeeLimitEnabled) puede bloquear el registro.
    //
    // Todas las transiciones de estado que importan (waiting→offered→
    // promoted/expired/declined, offerToken, offerExpiresAt,
    // promotedGuestId, promotionReason) son EXCLUSIVAS de Cloud Functions
    // (Admin SDK, ignora estas reglas) — el cliente público solo puede crear
    // una entrada 'waiting', nunca fabricarse una oferta ni promoverse a sí
    // mismo. Por eso esta validación es más chica que un alta de invitado:
    // no hay tantos campos de estado que pinear porque casi ninguno es
    // escribible por el cliente para empezar.
    function isValidWaitlistJoinData(evData, d) {
      return d.name is string && d.name.size() > 0 && d.name.size() <= 121
        && d.partySize is int && d.partySize >= 1 && d.partySize <= evData.get('maxCompanions', 9) + 1
        && (!('phone' in d) || (d.phone is string && d.phone.size() <= 40))
        && (!('phoneCountry' in d) || (d.phoneCountry is string && d.phoneCountry.size() <= 2))
        && (!('email' in d) || (d.email is string && d.email.size() <= 254))
        // Ver isValidPublicGuestContact — mismo criterio: solo `true`
        // (unirse a la lista de espera es siempre autoservicio, ver
        // WaitlistEntryData.whatsappConsent).
        && (!('whatsappConsent' in d) || d.whatsappConsent == true)
        // Respuestas a los campos personalizados del evento — tope de
        // customData.size() <= 30; el largo de cada valor individual no se
        // puede validar acá (Firestore rules no puede iterar un mapa),
        // solo lo valida el cliente.
        && (!('customData' in d) || (d.customData is map && d.customData.size() <= 30))
        && d.waitlistToken is string && d.waitlistToken.size() > 0
        && d.status == 'waiting'
        && d.priorityBoost == 0
        && d.createdAt == request.time
        && d.offerToken == null
        && d.offerExpiresAt == null
        && d.respondedAt == null
        && d.promotedGuestId == null
        && d.promotionReason == null
        // Anotarse a la lista de espera es siempre autoservicio — ver
        // GuestData.registrationSource / WaitlistEntryData.registrationSource.
        // Sin esto, un cliente público podría marcarse 'organizer' y saltarse
        // el tope de acompañantes si esta entrada se promueve más tarde.
        && d.registrationSource == 'self';
    }

    // attendeeLimitEnabled == false también bloquea: sin cupo duro no existe
    // "lleno", así que no debería poder crearse ninguna entrada (evita ruido/
    // abuso de una colección que en ese caso nunca la va a procesar nadie).
    function canJoinWaitlist(eventId, d) {
      let evData = eventDataFor(eventId);
      return evData.entryMode in ['open', 'hybrid']
        && evData.get('attendeeLimitEnabled', false) == true
        && isValidWaitlistJoinData(evData, d);
    }

    // Misma forma que isValidWaitlistJoinData, salvo el tope de partySize:
    // ahí se acota a maxCompanions+1 porque es un alta nueva de cero
    // acompañantes; acá el invitado YA existía con ese partySize (validado
    // cuando se lo agregó originalmente, quizás bajo otro maxCompanions o
    // como 'familia o grupo' con su propio tope), así que no vuelve a
    // pinearse contra el límite vigente hoy.
    function isValidOrganizerWaitlistEntryData(d) {
      return d.name is string && d.name.size() > 0 && d.name.size() <= 121
        && d.partySize is int && d.partySize >= 1
        && (!('phone' in d) || (d.phone is string && d.phone.size() <= 40))
        && (!('phoneCountry' in d) || (d.phoneCountry is string && d.phoneCountry.size() <= 2))
        && (!('email' in d) || (d.email is string && d.email.size() <= 254))
        && (!('customData' in d) || (d.customData is map && d.customData.size() <= 30))
        && d.waitlistToken is string && d.waitlistToken.size() > 0
        && d.status == 'waiting'
        && d.priorityBoost == 0
        && d.createdAt == request.time
        && d.offerToken == null
        && d.offerExpiresAt == null
        && d.respondedAt == null
        && d.promotedGuestId == null
        && d.promotionReason == null
        // Mirroreado del registrationSource del invitado que se está
        // moviendo (moveGuestToWaitlist ya lo copia tal cual) — solo se
        // valida el tipo, no se recalcula acá.
        && d.registrationSource in ['organizer', 'self'];
    }

    // "Enviar a la lista de espera" (src/firebase/guests.ts,
    // moveGuestToWaitlist): el organizador convierte a un invitado sin pagar
    // que no llegó en una entrada de espera nueva, en vez de borrarlo del
    // todo (deleteGuest) — libera su lugar igual, pero conserva el registro
    // por si aparece más tarde. No exige entryMode/attendeeLimitEnabled a
    // diferencia del alta pública: acá lo decide un organizador con permiso
    // de gestión de invitados, no la configuración pública del evento.
    // Gateado por 'deleteGuests' (no 'addGuests') porque siempre viaja junto
    // al delete del guest original, en el mismo batch — mismo permiso que ya
    // exige esa baja.
    function canOrganizerCreateWaitlistEntry(eventId, d) {
      return canDo(eventId, 'deleteGuests', true) && isValidOrganizerWaitlistEntryData(d);
    }

    // Contadores del EVENTO tolerantes a documentos legacy: eventos creados
    // antes de que existieran estos campos no los tienen, y en reglas de
    // Firestore leer una clave ausente (resource.data.peopleCount) es un
    // ERROR que deniega la escritura entera — era la causa del
    // "Missing or insufficient permissions" del autoregistro público sobre
    // eventos viejos. El fallback de peopleCount a guestCount replica el
    // mismo criterio que ya usan la lectura (getEvent, src/firebase/events.ts)
    // y la escritura (registerWalkInGuest, src/firebase/capacity.ts, que
    // backfillea el campo con este mismo valor).
    function eventGuestCountBefore(evData) {
      return evData.get('guestCount', 0);
    }

    function eventPeopleCountBefore(evData) {
      return evData.get('peopleCount', eventGuestCountBefore(evData));
    }

    function isValidPublicGuestContact() {
      let d = request.resource.data;
      return (!('email' in d) || (d.email is string && d.email.size() <= 120))
        && (!('phone' in d) || (d.phone is string && d.phone.size() <= 30))
        && (!('phoneCountry' in d) || (d.phoneCountry is string && d.phoneCountry.size() <= 5))
        // Solo `true` — el propio invitado nunca tiene motivo para mandar
        // `false` (ausencia ya significa "sin consentimiento"); revocar
        // consentimiento no es un flujo de autoservicio hoy (ver
        // GuestData.whatsappConsent).
        && (!('whatsappConsent' in d) || d.whatsappConsent == true);
    }

    // Tamaño de `companions` de un documento dado (`d`), sea cual sea su
    // representación actual: array (organizador, o cualquier invitado que ya
    // haya editado su información una vez) o número legado (autoregistro
    // público vía registerWalkInGuest/capacity.ts, que nunca escribe un
    // array — ver normalizeCompanions() en src/firebase/guests.ts, misma
    // traducción del lado cliente). Reutilizada tanto para el doc VIEJO
    // (resource.data, ver companionsCountBefore) como para el NUEVO
    // (request.resource.data, ver companionsWithinLimit).
    function companionsCountOf(d) {
      return d.companions is list
        ? d.companions.size()
        : (d.companions is number ? d.companions : 0);
    }

    // Tamaño de `companions` ANTES de esta escritura. Sin esto,
    // resource.data.companions.size() lanzaría un error de tipo para todo
    // invitado autoregistrado en un evento open/hybrid, bloqueando el
    // self-edit justo para el público que más lo necesita.
    function companionsCountBefore() {
      return companionsCountOf(resource.data);
    }

    // `d` es el documento NUEVO (request.resource.data) que se está
    // actualizando. Solo aplica el tope de acompañantes configurado por el
    // organizador (EventData.maxCompanions, default 9 — ver el mismo default
    // en GUEST_LEGACY_MAX_COMPANIONS de src/utils/validation.ts) cuando el
    // invitado EXISTENTE (resource.data) tiene `registrationSource == 'self'`
    // (autoregistro) — un invitado cargado manualmente por el organizador (o
    // legacy, sin el campo: default 'organizer', mismo criterio permisivo que
    // el resto del modelo) no está sujeto a ese tope, ver
    // GuestData.registrationSource. No hay rama `create` equivalente: el
    // alta manual del organizador no pasa nunca por esta regla (ver
    // `allow create` más abajo), y el autoregistro público corre 100% por
    // Cloud Functions (Admin SDK, ignora estas reglas) — la única escritura
    // real que llega hasta acá es la edición del organizador.
    //
    // `allowGrandfathered` (literal true/false en cada call site, nunca una
    // expresión que dependa de `resource`) habilita tolerar un valor por
    // ENCIMA del límite si no lo está AUMENTANDO respecto del documento viejo
    // — así un invitado autoregistrado antes de configurar este límite (o
    // antes de que existiera el campo) se puede seguir editando/guardando sin
    // recortarlo a la fuerza; solo se bloquea sumar más acompañantes por
    // encima del tope.
    //
    // Variante que recibe `evData` ya cargado en vez de volver a pedir el
    // documento del evento — mismo motivo que
    // isOwnerData/canDoData más arriba. Usada en guests/{guestId} (ver
    // `allow update`), donde SÍ hace falta un `get()` al evento (a diferencia
    // de `events/{eventId}`, que ya tiene su propio documento como
    // resource.data) pero solo UNA vez para toda la regla, no una vez por
    // cada rama que lo necesite.
    function companionsWithinLimitData(evData, d, allowGrandfathered) {
      return resource.data.get('registrationSource', 'organizer') != 'self'
        || d.get('isGroup', false) == true
        || companionsCountOf(d) <= evData.get('maxCompanions', 9)
        || (allowGrandfathered && companionsCountOf(d) <= companionsCountBefore());
    }

    // Auto-edición del propio invitado desde su pase (GuestPass, "Editar mis
    // datos"). NO permite variar la CANTIDAD de acompañantes — solo sus
    // datos (ver companionsCountBefore). Límites deben coincidir con
    // GUEST_NAME_PART_MAX/GUEST_CUSTOM_FIELD_MAX_COUNT en
    // src/utils/validation.ts. El largo individual de cada nombre/apellido/
    // teléfono dentro de `companions` y de cada valor de `customData` NO se
    // valida acá — Firestore Rules no puede iterar los elementos de un
    // array/mapa para exigir una condición por elemento (misma limitación ya
    // documentada arriba en isValidPublicGuestRegistration para customData);
    // esa validación por elemento la hace solo el cliente (ver
    // updateGuestSelf en src/firebase/guests.ts).
    function isValidGuestSelfEdit() {
      let d = request.resource.data;
      return d.name is string && d.name.size() > 0 && d.name.size() <= 121
        && (!('lastName' in d) || (d.lastName is string && d.lastName.size() <= 60))
        && d.companions is list
        && d.companions.size() == companionsCountBefore()
        && (!('customData' in d) || (d.customData is map && d.customData.size() <= 30))
        // Feature 6 (menú y restricciones alimenticias): igual criterio
        // laxo que customData arriba — solo se limita tamaño/tipo, no forma
        // interna (optionId/restrictionIds siempre vienen de
        // MenuSelectionInput, nunca tecleados a mano). La de cada
        // acompañante viaja dentro de `companions` (ya validado arriba, sin
        // chequeo campo por campo — mismo criterio que name/phone de cada
        // acompañante hoy).
        && (!('menuSelection' in d) || (d.menuSelection is map && d.menuSelection.size() <= 5));
    }

    // Tope de dispositivos reconocidos por pase (ver claimGuestPass en
    // src/firebase/guests.ts) — debe coincidir con INDIVIDUAL_DEVICE_CAP/
    // GROUP_DEVICE_CAP ahí. Solo actúa como techo de tamaño del arreglo
    // (defensa en profundidad); la rotación LRU real la hace el cliente.
    function guestDeviceCap(guestData) {
      return guestData.get('isGroup', false) ? 8 : 3;
    }

    // Un pase se considera "sin reclamar todavía" si nunca se guardó
    // `lockTokens` (invitado creado antes de este campo, o que nunca abrió
    // su pase) — mismo criterio permisivo que antes tenía `lockToken ==
    // null`. Una vez reclamado, cualquier dispositivo de la lista puede
    // escribir (RSVP, comprobante de pago, auto-edición) — ya no hace falta
    // ser exactamente EL dispositivo que ganó la primera carrera.
    function guestLockTokensOk(guestData, incomingToken) {
      return !('lockTokens' in guestData) ||
        guestData.lockTokens.size() == 0 ||
        incomingToken in guestData.lockTokens;
    }

    // La confirmación de pago (paymentStatus/paymentMethod/paidAt/paidBy) y
    // todo el proceso de acceso (status/checkedInAt/checkedInBy(Email)/
    // checkedOutAt/checkedOutByEmail/exitType) son exclusivos de las Cloud
    // Functions setGuestPaymentStatus/bulkSetGuestPaymentStatus/
    // checkInGuest/checkOutGuest/confirmPaymentAndCheckIn/allowGuestReentry
    // (Admin SDK, ignora estas reglas) — ver functions/src/payments/ y
    // functions/src/checkin/. Se usa para acotar las 2 ramas de
    // `guests/{guestId}` que, de otra forma, quedarían sin restricción de
    // campos (editGuests e isAdmin) y podrían pisar estos campos directo
    // desde un cliente. NO se usa en la rama de submitPaymentProof (el
    // invitado marcando "ya pagué"): esa sigue siendo una escritura de
    // cliente legítima, ya acotada por su propio hasOnly.
    function accessControlFieldsUntouched(oldData, newData) {
      return !newData.diff(oldData).affectedKeys().hasAny([
        'paymentStatus', 'paymentMethod', 'paidAt', 'paidBy',
        'status', 'checkedInAt', 'checkedInBy', 'checkedInByEmail',
        'checkedOutAt', 'checkedOutByEmail', 'exitType', 'presentIndices'
      ]);
    }

    // Control de concurrencia optimista de guests/{guestId} (evitar que dos
    // organizadores/dispositivos editando el mismo invitado se pisen en
    // silencio, ver src/firebase/guests.ts:assertGuestVersion). Exige que
    // `version` avance en EXACTAMENTE +1 respecto del valor ya guardado (no
    // un increment() relativo — así, si el cliente arrancó su edición desde
    // una versión que ya quedó vieja porque alguien más escribió antes,
    // `version` que manda ya no calza contra la actual y la escritura se
    // rechaza) y que `updatedAt` sea el timestamp real del servidor (mismo
    // patrón que `createdAt == request.time` en otras colecciones de este
    // archivo).
    //
    // Se exige en la rama de auto-edición del invitado (hasOnly acotado,
    // caso de uso claro: updateGuestSelf) y en las 2 ramas del organizador/
    // admin (editGuests/isAdmin) que NO restringen qué campos se pueden
    // tocar — esas dos son el fallback de CUALQUIER escritura del
    // organizador que no encaje en una rama más específica (tableId,
    // reconfirmDeadline, etc. tienen la suya propia), así que no solo cubren
    // updateGuest: también resetGuestRsvp, unlockGuestPass y
    // bulkSetGuestTags cotizan contra esta misma rama y por eso ellas
    // también avanzan `version` (con increment(), ver guestVersionBump en
    // src/firebase/guests.ts — no necesitan detectar conflicto, solo
    // mantener el campo consistente). El resto de las ramas de
    // `guests/{guestId}` (RSVP del invitado, comprobante de pago, reconfirmar,
    // dispositivos reconocidos, vincular cuenta) son transiciones de estado
    // de 1-2 campos ya protegidas por su propia lectura fresca / gate de
    // lockTokens y no llevan este chequeo.
    function guestVersionOk(oldData, newData) {
      return newData.version == oldData.get('version', 0) + 1
        && newData.updatedAt == request.time;
    }

    // Cruza con guests/{guestId} (que sí tiene lockTokens) para autorizar la
    // auto-edición de guestContacts (email/phone) del mismo invitado — ese
    // documento no tiene su propia lista de dispositivos.
    function guestSelfEditContactLockOk(eventId, guestId) {
      let guestPath = /databases/$(database)/documents/events/$(eventId)/guests/$(guestId);
      return exists(guestPath) &&
        guestLockTokensOk(get(guestPath).data, request.resource.data.get('lockToken', null));
    }


    // ---- Concessions (venta de comida/bebida durante el evento) ----
    // Ver FOOD_BEVERAGE_ORDERING_ARCHITECTURE.md. Namespace 'concessions',
    // nunca 'menu' (EventData.menu ya existe para selección de plato del
    // RSVP/banquete, un concepto distinto). Todo lo de acá abajo asume que
    // `concessions.enabled` ya está en `true` (ver concessionsEnableChangeIsAllowed
    // más arriba) — se revalida igual en cada match, por si alguien intenta
    // escribir directo contra una subcolección de un evento donde el módulo
    // nunca se activó.
    function concessionsEnabled(evData) {
      return evData.get('concessions', {}).get('enabled', false) == true;
    }

    // Los encargados de "Ventas del evento" (caja/preparación) NO son
    // co-organizadores — son roles aparte, sin acceso a
    // invitados/reportes/configuración del evento (ver RFC §8.2). Mismo
    // patrón de mapa que coOrganizersMap, pero en su propio namespace para
    // que nunca se confundan con uno. El valor del mapa puede ser el shape
    // legado (string = solo el email, encargados dados de alta antes de la
    // invitación por enlace) o el shape nuevo (map con `roles.cashier`/
    // `roles.prep`) — un string legado se trata como solo-preparación,
    // el único acceso que esos encargados ya tenían en la práctica.
    function concessionsStaffEntry(evData) {
      return evData.get('concessions', {}).get('concessionsStaffMap', {}).get(request.auth.uid, null);
    }
    // Pertenece al staff (cualquier rol) — usado para distinguir "es un
    // encargado sin el rol necesario acá" (denegar) de "no es del staff en
    // absoluto, es el invitado dueño del pedido vía bearer-link" (permitir),
    // ver `concessionsFulfillment.get/list` más abajo.
    // Cada una de las tres funciones de abajo reconoce, además del shape
    // legado de concessionsStaffMap, una entrada equivalente en el mapa
    // unificado event.collaborators (role 'caja'/'preparacion' — ver
    // ROLES_PERMISSIONS_REDESIGN.md Fase 3). 'administrador'/'ventas' NO
    // necesitan pasar por acá: ya tienen acceso más amplio vía
    // canDo(eventId,'manageConcessions'/'confirmPayments',...), que ya es
    // collaborators-aware (ver coOrgPermData).
    function isConcessionsStaffMember(evData) {
      let collab = collaboratorEntry(evData);
      return request.auth != null &&
        (concessionsStaffEntry(evData) != null ||
         (collab != null && collab.get('role', '') in ['caja', 'preparacion']));
    }
    function isConcessionsCashier(evData) {
      let entry = concessionsStaffEntry(evData);
      let collab = collaboratorEntry(evData);
      return request.auth != null && (
        (entry != null && entry is map && entry.get('roles', {}).get('cashier', false) == true) ||
        (collab != null && collab.get('role', '') == 'caja')
      );
    }
    function isConcessionsPrep(evData) {
      let entry = concessionsStaffEntry(evData);
      let collab = collaboratorEntry(evData);
      return request.auth != null && (
        (entry != null && (entry is string || entry.get('roles', {}).get('prep', false) == true)) ||
        (collab != null && collab.get('role', '') == 'preparacion')
      );
    }

    // Prueba de que quien escribe es dueño de ESTE pedido: igual criterio que
    // guestSelfEditContactLockOk (un invitado sin cuenta obligatoria no tiene
    // uid que comparar, así que la prueba real es conocer un lockToken ya
    // reconocido por su propio documento guests/{guestId} — o el pase sin
    // reclamar todavía). `lockToken` viaja en el propio pedido solo para
    // poder probar esto en un documento hermano, igual motivo por el que
    // guestContacts también lo carga.
    function isGuestOrderActor(eventId, guestId, lockToken) {
      let guestPath = /databases/$(database)/documents/events/$(eventId)/guests/$(guestId);
      return exists(guestPath) && guestLockTokensOk(get(guestPath).data, lockToken);
    }

    // isValidConcessionOrderCreate/isValidConcessionStockDecrement/
    // isValidConcessionSoldCountBump/isValidConcessionStockRelease existieron
    // acá (solo validaban forma/tipos, nunca podían verificar que el
    // precio/stock declarado coincidiera con el catálogo real) hasta que
    // createConcessionOrder/cancelConcessionOrder se migraron a Cloud
    // Functions (ver FIRESTORE_RULES_SIMPLIFICATION_AUDIT.md Fase B): ahora
    // ambas transacciones corren con Admin SDK, releen concessionsCatalog
    // como única fuente de verdad, y escriben bypasseando estas reglas —
    // así que la escritura directa de cliente sobre `concessionsOrders`
    // (`create`) y sobre `stockRemaining`/`soldCount` de `concessionsCatalog`
    // (`update`) ya no tiene ninguna rama que la autorice más abajo.

    function isValidConcessionItem(d) {
      return d.name is string && d.name.size() > 0 && d.name.size() <= 80
        && (!('description' in d) || (d.description is string && d.description.size() <= 500))
        && d.category in ['drink', 'food', 'snack', 'souvenir', 'special']
        && d.priceMinorUnits is int && d.priceMinorUnits >= 0
        && d.currency is string && d.currency.size() > 0 && d.currency.size() <= 10
        && d.stockMode in ['unlimited', 'limited']
        && d.status in ['active', 'outOfStock', 'archived']
        && d.sortOrder is number;
    }

    // Sin alta pública ni desde la app: la única forma de agregar/quitar un
    // admin es a mano desde la consola de Firebase (que opera con acceso de
    // propietario del proyecto y no pasa por estas reglas). `allow read`
    // solo le permite a cada usuario confirmar si ES admin — no listar ni
    // ver el resto de la colección.
    match /admins/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow write: if false;
    }

    // Modo mantenimiento (doc singleton, ver src/hooks/useMaintenanceMode.ts
    // y MaintenanceGate.tsx). `allow get` es público a propósito, sin
    // request.auth != null: MaintenanceGate lo lee ANTES de saber si hay
    // sesión (incluso en /login), así que un visitante sin cuenta también
    // necesita poder leerlo para ver la pantalla de mantenimiento en vez de
    // una app rota. Solo expone un booleano + un mensaje corto, sin datos
    // sensibles. Escribir sí requiere isAdmin(), igual que cualquier otro
    // control administrativo.
    match /platformConfig/{docId} {
      allow get: if true;
      allow list: if false;
      allow write: if isAdmin()
        && request.resource.data.keys().hasOnly(['enabled', 'message', 'updatedAt', 'updatedBy'])
        && request.resource.data.enabled is bool
        && request.resource.data.message is string
        && request.resource.data.message.size() <= 300
        && request.resource.data.updatedBy == request.auth.uid;
    }

    // Buzón de feedback (src/pages/Feedback.tsx). Solo el admin puede leer —
    // ni siquiera el propio autor puede releer lo que envió (pedido
    // explícito: "no permitir que usuarios lean comentarios de otros").
    // Los campos gestionados por el admin (status/priority/tags/adminNotes/
    // favorite/read) deben llegar en sus valores por defecto en el create —
    // si no, cualquier cliente podría auto-marcarse "resuelto" o inyectar
    // notas privadas desde el primer envío.
    function isValidFeedbackCreate() {
      let d = request.resource.data;
      return d.subject is string && d.subject.size() > 0 && d.subject.size() <= 100
        && d.message is string && d.message.size() >= 10 && d.message.size() <= 2000
        && d.category in ['suggestion', 'bug', 'comment', 'question', 'inappropriate', 'feature_request', 'other']
        && d.status == 'new' && d.priority == 'normal'
        && d.tags == [] && d.adminNotes == '' && d.favorite == false && d.read == false
        && (
          (request.auth != null && d.userId == request.auth.uid && d.userEmail == null)
          || (request.auth == null && d.userId == null
              && d.userEmail is string && d.userEmail.size() > 0 && d.userEmail.size() <= 120)
        );
    }

    // Cooldown real (server-verificado) solo es posible para usuarios
    // logueados, porque solo ahí request.auth.uid no se puede falsificar.
    // Un envío anónimo no tiene una identidad que las reglas puedan atar a
    // esta clave — se compensa del lado cliente (ver submitFeedback), mismo
    // criterio ya aceptado en este archivo para los votos del muro (abajo).
    function feedbackCooldownOk() {
      let rl = /databases/$(database)/documents/feedbackRateLimits/$(request.auth.uid);
      return !exists(rl) || request.time > get(rl).data.lastAt + duration.value(45, 's');
    }

    match /feedback/{feedbackId} {
      allow read, list: if isAdmin();
      allow create: if isValidFeedbackCreate()
        && (request.auth == null || feedbackCooldownOk());
      allow update, delete: if isAdmin();
    }

    match /feedbackRateLimits/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow write: if request.auth != null && request.auth.uid == uid
        && request.resource.data.lastAt == request.time;
    }

    // Reportes de contenido del muro (comentarios/fotos) — src/firebase/moderation.ts.
    // Solo admin puede leer/listar/actualizar, igual que /feedback: el reporte
    // incluye datos del reportador y del reportado que no deben quedar
    // expuestos a nadie más. "Solo usuarios autenticados pueden reportar"
    // (pedido explícito) es lo que permite además el cooldown y el bloqueo de
    // duplicados server-verificados abajo, a diferencia del envío anónimo de
    // feedback que solo puede protegerse "mejor esfuerzo" del lado cliente.
    function reportCooldownOk() {
      let rl = /databases/$(database)/documents/reportRateLimits/$(request.auth.uid);
      return !exists(rl) || request.time > get(rl).data.lastAt + duration.value(20, 's');
    }

    function reportNotDuplicate(contentId) {
      let dd = /databases/$(database)/documents/reportDedup/$(request.auth.uid)/targets/$(contentId);
      return !exists(dd) || request.time > get(dd).data.lastAt + duration.value(24, 'h');
    }

    function isValidReportCreate() {
      let d = request.resource.data;
      return request.auth != null
        && d.reporterUid == request.auth.uid
        && d.eventId is string && d.eventId.size() > 0
        && d.eventName is string && d.eventName.size() <= 200
        && d.contentType in ['comment', 'photo']
        && d.contentId is string && d.contentId.size() > 0
        && d.contentSnapshot is string && d.contentSnapshot.size() <= 1000
        && d.contentAuthorName is string && d.contentAuthorName.size() <= 120
        && d.reporterName is string && d.reporterName.size() <= 120
        && d.reason is string && d.reason.size() >= 10 && d.reason.size() <= 500
        && d.status == 'pending' && d.adminNotes == '' && d.actionHistory == []
        && reportCooldownOk() && reportNotDuplicate(d.contentId);
    }

    match /reports/{reportId} {
      allow read, list: if isAdmin();
      allow create: if isValidReportCreate();
      allow update, delete: if isAdmin();
    }

    match /reportRateLimits/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow write: if request.auth != null && request.auth.uid == uid
        && request.resource.data.lastAt == request.time;
    }

    match /reportDedup/{uid}/targets/{contentId} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow create, update: if request.auth != null && request.auth.uid == uid
        && request.resource.data.lastAt == request.time;
      allow delete: if false;
    }

    // Plantillas comunitarias (feature de innovación): diseñadores externos
    // proponen una plantilla (colores/tipografía/etc, ver TemplateVars en
    // registry.ts) que un admin revisa antes de publicarla. Mismo patrón que
    // /reports (requiere auth, a diferencia de /feedback que admite envío
    // anónimo) — acá no tiene sentido un envío anónimo porque el autor debe
    // poder ver el estado de sus propios envíos después.
    //
    // get/list con 3 perspectivas simultáneas (isAdmin ve todo, el autor ve
    // lo propio en cualquier estado, cualquier usuario logueado ve las
    // aprobadas para elegirlas en TemplatePicker) — Firestore evalúa esta
    // regla por CADA documento que la query podría devolver, así que el
    // cliente debe consultar con un where() que ya acote a uno de estos 3
    // casos (ver src/firebase/communityTemplates.ts) para que la query entera
    // no sea rechazada.
    function isValidCommunityTemplateCreate() {
      let d = request.resource.data;
      return request.auth != null
        && d.authorUid == request.auth.uid
        && d.name is string && d.name.size() > 0 && d.name.size() <= 60
        && d.description is string && d.description.size() <= 500
        && d.category is string && d.category.size() > 0
        && d.status in ['draft', 'in_review']
        && d.version == 1
        && !('reviewerUid' in d) && !('reviewNotes' in d) && !('publishedAt' in d);
    }

    // El autor solo puede tocar su propio envío mientras está en borrador o
    // fue rechazado (reenvío), y solo puede moverlo a 'draft'/'in_review' —
    // nunca a 'approved'/'archived', y nunca puede tocar los campos que
    // gestiona el admin (reviewerUid/reviewNotes/publishedAt deben llegar
    // exactamente iguales a como estaban).
    function isValidCommunityTemplateAuthorUpdate() {
      let d = request.resource.data;
      let before = resource.data;
      return request.auth != null
        && before.authorUid == request.auth.uid
        && before.status in ['draft', 'rejected']
        && d.authorUid == before.authorUid
        && d.status in ['draft', 'in_review']
        && d.get('reviewerUid', null) == before.get('reviewerUid', null)
        && d.get('reviewNotes', null) == before.get('reviewNotes', null)
        && d.get('publishedAt', null) == before.get('publishedAt', null);
    }

    match /communityTemplates/{templateId} {
      allow get, list: if isAdmin()
        || (request.auth != null && resource.data.authorUid == request.auth.uid)
        || (request.auth != null && resource.data.status == 'approved');
      allow create: if isValidCommunityTemplateCreate();
      allow update: if isAdmin() || isValidCommunityTemplateAuthorUpdate();
      allow delete: if isAdmin()
        || (request.auth != null && resource.data.authorUid == request.auth.uid && resource.data.status == 'draft');
    }

    // Sanciones de moderación (src/firebase/sanctions.ts). El resumen en
    // sanctions/{uid} es lo que consultan estas mismas reglas para bloquear
    // comentarios/fotos de una cuenta sancionada (ver isBanned/commentsBlocked/
    // photosBlocked más abajo) y lo que el propio usuario puede leer para
    // saber por qué está restringido — pero solo el admin puede escribirlo.
    // El historial detallado (para el panel de admin) vive aparte y nunca lo
    // lee la app del usuario sancionado.
    match /sanctions/{uid} {
      allow read: if request.auth != null && (request.auth.uid == uid || isAdmin());
      allow write: if isAdmin();

      match /history/{entryId} {
        allow read, create: if isAdmin();
        allow update, delete: if false;
      }
    }

    // Consultadas desde las reglas del muro/fotos más abajo — siempre detrás
    // de un `request.auth == null || ...` en el punto de llamada (mismo
    // criterio que feedbackCooldownOk arriba), así que estas funciones pueden
    // asumir que request.auth ya existe. Reglas de Firestore no soportan
    // `if`/`else` como statement, solo expresiones booleanas de corto-circuito
    // (`&&`/`||`) — por eso no hay early-return acá, cada función es una sola
    // expresión que evita llamar a get() cuando exists() ya dio false.
    function isBanned(eventId) {
      let path = /databases/$(database)/documents/sanctions/$(request.auth.uid);
      return exists(path) && (
        (('global' in get(path).data) && get(path).data.global.bannedUntil > request.time.toMillis())
        || (('events' in get(path).data) && (eventId in get(path).data.events) && get(path).data.events[eventId].bannedUntil > request.time.toMillis())
      );
    }

    function commentsBlocked(eventId) {
      let path = /databases/$(database)/documents/sanctions/$(request.auth.uid);
      return isBanned(eventId) || (exists(path) && (
        (('global' in get(path).data) && get(path).data.global.commentBanUntil > request.time.toMillis())
        || (('events' in get(path).data) && (eventId in get(path).data.events) && get(path).data.events[eventId].commentBanUntil > request.time.toMillis())
      ));
    }

    function photosBlocked(eventId) {
      let path = /databases/$(database)/documents/sanctions/$(request.auth.uid);
      return isBanned(eventId) || (exists(path) && (
        (('global' in get(path).data) && get(path).data.global.photoBanUntil > request.time.toMillis())
        || (('events' in get(path).data) && (eventId in get(path).data.events) && get(path).data.events[eventId].photoBanUntil > request.time.toMillis())
      ));
    }

    // Bitácora de acciones del admin (AdminDashboard). Solo el admin puede
    // leerla o crear entradas — nunca editarla ni borrarla, para que quede
    // como un registro confiable de qué se hizo y quién lo hizo.
    match /adminAuditLog/{logId} {
      allow read: if isAdmin();
      allow create: if isAdmin()
        && request.resource.data.adminUid == request.auth.uid
        && request.resource.data.action is string
        && request.resource.data.targetType is string
        && request.resource.data.targetId is string;
      allow update, delete: if false;
    }

    // Presupuesto diario compartido de envíos de email (recordatorios,
    // lista de espera/reconfirmación), consumido por los scripts Node/Cloud
    // Functions vía firebase-admin para no exceder el tope diario del
    // proveedor (Brevo). Lectura admin
    // habilitada para la alerta "cerca del límite de envío diario" del
    // Centro de Control (ver src/firebase/adminAlerts.ts) — sigue siendo
    // uso puramente interno para escritura (scripts/Cloud Functions).
    match /sendBudget/{dateKey} {
      allow read: if isAdmin();
      allow write: if false;
    }

    // Contadores agregados de plataforma mantenidos SOLO por Admin SDK
    // (triggers/Cloud Functions) — nunca por el cliente. Hoy solo
    // `funnel` (usersWithEventsCount, ver functions/src/triggers/
    // onEventCreated.ts) y el marcador interno `funnelMarkers/users/{uid}`
    // usado para dedup de "primer evento". No se usa CounterService/
    // sharding acá: son escrituras de baja frecuencia (una vez por evento
    // creado), sin la contención de alta frecuencia que sí justifica el
    // sharding en contadores por-evento (ver src/firebase/counters/).
    match /platformStats/{document=**} {
      allow read: if isAdmin();
      allow write: if false;
    }

    // Contadores de sesión por sistema operativo/navegador (Centro de
    // Control → "Dispositivos", ver src/firebase/deviceStats.ts). Sin PII:
    // solo una categoría cerrada (bucketId) y un conteo agregado, nunca un
    // user-agent completo ni un id de usuario. Escritura DIRECTA de
    // cliente (no vía Cloud Function) porque el dato es de bajísimo riesgo
    // — a lo sumo un cliente hostil infla un contador de analítica interna,
    // nunca puede leer ni tocar el conteo de otro bucket ni ningún otro
    // documento.
    match /deviceStats/{bucketId} {
      allow read: if isAdmin();
      allow create: if request.auth != null
        && bucketId in [
          'os_android', 'os_ios', 'os_windows', 'os_mac', 'os_linux', 'os_other',
          'browser_chrome', 'browser_safari', 'browser_firefox', 'browser_edge', 'browser_other'
        ]
        && request.resource.data.keys().hasOnly(['kind', 'key', 'count'])
        && request.resource.data.count == 1;
      allow update: if request.auth != null
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['count'])
        && request.resource.data.count == resource.data.count + 1;
      allow delete: if false;
    }

    match /users/{userId} {
      allow get: if request.auth != null && (request.auth.uid == userId || isAdmin());
      // El admin puede listar todos los usuarios (AdminDashboard). Cualquier otro usuario
      // logueado solo puede hacer búsquedas puntuales (getUserByEmail usa limit(1)).
      allow list: if isAdmin() || (request.auth != null && request.query.limit <= 1);
      allow write: if request.auth != null && request.auth.uid == userId;

      match /invitations/{invId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }

      // Historial de aceptación de Términos/Privacidad (ver src/firebase/legalAcceptance.ts).
      // Mismo criterio que adminAuditLog: solo se puede crear, nunca editar ni borrar,
      // para que quede como un registro confiable de qué versión aceptó cada usuario.
      match /legalAcceptances/{acceptanceId} {
        allow read: if request.auth != null && (request.auth.uid == userId || isAdmin());
        allow create: if request.auth != null && request.auth.uid == userId
          && request.resource.data.acceptedAt == request.time
          && request.resource.data.documents is list;
        allow update, delete: if false;
      }
    }

    match /events/{eventId} {
      allow read: if true;
      allow create: if request.auth != null && request.auth.uid == request.resource.data.ownerId
        && isValidEventPricing() && isValidMaxCompanions() && eventContentCapsOk();
      // checkinsByHour explícitamente afuera de la rama sin restricción de
      // campos del dueño/admin (igual que accessControlFieldsUntouched hace
      // en guests/{guestId}) — si no, el dueño podría fabricar el gráfico
      // "Llegadas por hora" de Reports directo, sin pasar por la Cloud
      // Function checkInGuest. checkedInCount/occupancyCount NO se agregan
      // acá: walkIn/walkOut (capacity.ts, fuera de esta migración) siguen
      // necesitando que el dueño los escriba directo, y ya están cubiertos
      // por la rama scanQr de abajo (hasOnly(['checkedInCount', 'occupancyCount'])),
      // que el dueño también satisface vía canDoData/isOwnerData.
      allow update: if (isOwnerData(resource.data) || isAdmin()) && eventContentCapsOk()
          && concessionsEnableChangeIsAllowed(resource.data, request.resource.data)
          && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['checkinsByHour'])
        // Contador walk-in (Opciones A y C, src/firebase/capacity.ts —
        // walkIn/walkOut): solo quien tiene el permiso `scanQr` (dueño
        // siempre lo tiene vía canDo), y solo tocando los dos contadores de
        // presencia. checkInGuest/checkOutGuest/confirmPaymentAndCheckIn ya
        // NO pasan por esta rama (migrados a Cloud Functions, Admin SDK —
        // ver functions/src/checkin/); walkIn/walkOut siguen siendo
        // transacciones de cliente (fuera del alcance de esa migración, es
        // un problema distinto de alta/capacidad), así que la rama se
        // angosta pero no desaparece. checkedInCount (asistencia acumulada)
        // y occupancyCount (ocupación en vivo) pueden cambiar juntos
        // (walkIn) o solo el segundo (walkOut cuando checkedInCount ya está
        // en 0) — por eso se valida cada uno por separado en vez de exigir
        // que ambos cambien a la vez. 'checkinsByHour' salió del hasOnly:
        // solo lo escribía checkInGuest, que ya es Admin SDK. 'walkInNetCount'
        // (ledger de walk-ins netos que reconcileGuestCounters.ts usa para
        // poder recomponer los dos contadores de arriba, ver counters/config.ts)
        // solo lo escriben walkIn/walkOut, con el mismo delta ±1 que
        // checkedInCount/occupancyCount en esa misma llamada.
        || (canDoData(resource.data, 'scanQr', true)
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['checkedInCount', 'occupancyCount', 'walkInNetCount'])
            && counterDeltaOk(request.resource.data.checkedInCount, resource.data.checkedInCount)
            && counterDeltaOk(request.resource.data.occupancyCount, resource.data.occupancyCount)
            && counterDeltaOk(request.resource.data.get('walkInNetCount', 0), resource.data.get('walkInNetCount', 0)))
        // Un co-organizador (no dueño, así que no cae en la primera rama de
        // este `allow update`) necesita poder tocar guestCount/peopleCount/
        // paidCount en estos casos: eliminar un invitado (deleteGuest,
        // decrementa guestCount/peopleCount y también paidCount si ya había
        // pagado) y cambiar la cantidad de acompañantes de un invitado ya
        // pagado (updateGuest ajusta peopleCount y paidCount por la misma
        // diferencia). También cubre agregar invitados (addGuest/
        // addGuestsBulk, permiso addGuests): guestCount/peopleCount suben ahí
        // de la misma forma. Mismo margen ±50 que counterDeltaOk ya usa para
        // los contadores de presencia arriba, no un exacto ±1: un borrado (o
        // una carga masiva) puede mover un grupo entero de una sola vez.
        // Gateado por CUALQUIERA de los 3 permisos que legítimamente disparan
        // esta escritura — no se puede exigir uno solo porque addGuest/
        // deleteGuest/updateGuest son operaciones distintas que comparten
        // este mismo rango de campos. `paidCount` sigue en el hasOnly porque
        // deleteGuest/updateGuest todavía lo tocan (borrar o editar
        // acompañantes de un invitado ya pagado); confirmPayments YA NO
        // aparece acá — setGuestPaymentStatus/bulkSetGuestPaymentStatus
        // (Cloud Functions, Admin SDK) ajustan paidCount directo, sin pasar
        // por esta regla.
        // rsvpYesCount/rsvpNoCount/rsvpPendingCount (auditoría F22): addGuest/
        // addGuestsBulk/addGuestsFromRows (permiso addGuests) suman al invitado
        // nuevo a rsvpPendingCount en la MISMA escritura que guestCount/
        // peopleCount — no es una rama aparte, así que estos 3 campos tienen
        // que estar en este mismo hasOnly.
        // attendeeLimitOk acá también: esta rama es la que usa addGuest/
        // addGuestsBulk/addGuestsFromRows (alta manual/masiva/CSV) para subir
        // peopleCount — tiene que respetar el mismo cupo que el autorregistro
        // de arriba. No molesta a deleteGuests/editGuests (que comparten esta
        // rama): esas operaciones bajan o no tocan peopleCount, y
        // attendeeLimitOk siempre permite las bajas.
        || ((canDoData(resource.data, 'addGuests', true) || canDoData(resource.data, 'deleteGuests', true) || canDoData(resource.data, 'editGuests', true))
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['guestCount', 'peopleCount', 'paidCount', 'rsvpYesCount', 'rsvpNoCount', 'rsvpPendingCount'])
            && counterDeltaOk(request.resource.data.guestCount, resource.data.guestCount)
            && counterDeltaOk(request.resource.data.peopleCount, resource.data.peopleCount)
            && counterDeltaOk(request.resource.data.paidCount, resource.data.paidCount)
            && counterDeltaOk(request.resource.data.get('rsvpYesCount', 0), resource.data.get('rsvpYesCount', 0))
            && counterDeltaOk(request.resource.data.get('rsvpNoCount', 0), resource.data.get('rsvpNoCount', 0))
            && counterDeltaOk(request.resource.data.get('rsvpPendingCount', 0), resource.data.get('rsvpPendingCount', 0))
            && attendeeLimitOk(resource.data, request.resource.data))
        // deleteGuest borra un invitado que puede estar en cualquier
        // combinación de estados (adentro o no, pagado o no) — decrementa
        // guestCount/peopleCount siempre, y ADEMÁS checkedInCount/
        // occupancyCount (si estaba 'checked_in') y/o paidCount (si ya había
        // pagado) en la MISMA escritura al evento. Eso no encaja en ninguna
        // rama de arriba (cada una cubre un subconjunto fijo de campos para
        // una operación puntual) — sin esto, un coanfitrión con deleteGuests
        // (pero sin scanQr/confirmPayments) no podía borrar a un invitado que
        // ya había entrado o pagado: el batch entero (borrado + contadores)
        // se rechazaba. Gateado solo por deleteGuests — borrar ya autoriza
        // deshacer cualquiera de estos efectos derivados del invitado
        // borrado, no hace falta tener además scanQr/confirmPayments (mismo
        // criterio ya usado por counterDeltaOk: es margen de la OPERACIÓN,
        // no un permiso extra por cada campo que decida tocar).
        || (canDoData(resource.data, 'deleteGuests', true)
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['guestCount', 'peopleCount', 'checkedInCount', 'occupancyCount', 'paidCount', 'rsvpYesCount', 'rsvpNoCount', 'rsvpPendingCount'])
            && counterDeltaOk(request.resource.data.guestCount, resource.data.guestCount)
            && counterDeltaOk(request.resource.data.peopleCount, resource.data.peopleCount)
            && counterDeltaOk(request.resource.data.checkedInCount, resource.data.checkedInCount)
            && counterDeltaOk(request.resource.data.occupancyCount, resource.data.occupancyCount)
            && counterDeltaOk(request.resource.data.paidCount, resource.data.paidCount)
            && counterDeltaOk(request.resource.data.get('rsvpYesCount', 0), resource.data.get('rsvpYesCount', 0))
            && counterDeltaOk(request.resource.data.get('rsvpNoCount', 0), resource.data.get('rsvpNoCount', 0))
            && counterDeltaOk(request.resource.data.get('rsvpPendingCount', 0), resource.data.get('rsvpPendingCount', 0)))
        // "Salir del evento": un co-organizador puede quitarse a sí mismo sin
        // pasar por el dueño. Solo puede tocar sus propias 2 entradas
        // (coOrganizersMap/coOrganizerPermissions) y hacerlas desaparecer —
        // no puede afectar invitados, pagos, ni ningún otro campo del evento.
        || (isCoOrganizerData(resource.data)
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['coOrganizersMap', 'coOrganizerPermissions', 'updatedAt'])
            && !(request.auth.uid in request.resource.data.get('coOrganizersMap', {}))
            && request.auth.uid in resource.data.get('coOrganizersMap', {}))
        // "Salir del evento", mismo criterio para un colaborador del sistema
        // unificado (Fase 4 de ROLES_PERMISSIONS_REDESIGN.md) — mapa distinto
        // (`collaborators`, un solo campo por uid, no dos).
        || (isCoOrganizerData(resource.data)
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['collaborators', 'updatedAt'])
            && !(request.auth.uid in request.resource.data.get('collaborators', {}))
            && request.auth.uid in resource.data.get('collaborators', {}))
        // Administrar co-organizadores/colaboradores (permiso manageCoOrganizers,
        // default false): puede agregar/editar/quitar a OTROS colaboradores
        // (de cualquiera de los dos sistemas), pero no puede tocar su propia
        // entrada en ninguno de los tres mapas — ni para autoescalarse más
        // permisos ni para autoeliminarse por esta vía (para eso ya están las
        // 2 ramas de "salir del evento" de arriba).
        || (isCoOrganizerData(resource.data)
            && coOrgPermData(resource.data, 'manageCoOrganizers', false)
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['coOrganizersMap', 'coOrganizerPermissions', 'collaborators', 'updatedAt'])
            && request.resource.data.get('coOrganizersMap', {}).get(request.auth.uid, null) == resource.data.get('coOrganizersMap', {}).get(request.auth.uid, null)
            && request.resource.data.get('coOrganizerPermissions', {}).get(request.auth.uid, {}) == resource.data.get('coOrganizerPermissions', {}).get(request.auth.uid, {})
            && request.resource.data.get('collaborators', {}).get(request.auth.uid, null) == resource.data.get('collaborators', {}).get(request.auth.uid, null)
            && request.resource.data.get('coOrganizersMap', {}).size() <= 20
            && request.resource.data.get('collaborators', {}).size() <= 20)
        // RSVP (setGuestRsvp/resetGuestRsvp, auditoría F22) — ver
        // rsvpCountsOk más arriba. Sin gate de canDo/scanQr a propósito: lo
        // dispara el invitado sin cuenta desde su propio pase.
        || (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['rsvpYesCount', 'rsvpNoCount', 'rsvpPendingCount'])
            && rsvpCountsOk(resource.data, request.resource.data))
        // Autocancelación ("Cancelar mi asistencia", deleteGuest disparado
        // por el propio invitado desde GuestPass) — ver guestSelfCancelCountsOk
        // más arriba. Mismo criterio sin gate que la rama de RSVP de justo
        // arriba: el invitado no tiene cuenta necesariamente, así que la
        // única forma de habilitar esta escritura es sin permiso de por
        // medio — la función ya acota todo lo que puede moverse en un solo
        // request (un invitado por vez, sin tocar presencia).
        || (request.resource.data.diff(resource.data).affectedKeys()
              .hasOnly(['guestCount', 'peopleCount', 'checkedInCount', 'occupancyCount', 'paidCount', 'rsvpYesCount', 'rsvpNoCount', 'rsvpPendingCount'])
            && guestSelfCancelCountsOk(resource.data, request.resource.data))
        // Config/staff del módulo de comida/bebida (Fase 1, ver
        // FOOD_BEVERAGE_ORDERING_ARCHITECTURE.md): un co-organizador con
        // manageConcessions puede tocar TODO dentro de `concessions`
        // (nombre de tienda, métodos de pago, instrucciones, staff map)
        // salvo activar el módulo (`enabled` false→true, sigue exigiendo
        // admin vía concessionsEnableChangeIsAllowed). `concessions` aparece
        // como UN SOLO campo de nivel superior en diff().affectedKeys()
        // aunque la escritura real solo toque una subclave (ej.
        // `concessions.storeName`) — Firestore evalúa reglas contra el
        // documento resultante completo, no contra el path punteado que
        // mandó el cliente.
        || (canDoData(resource.data, 'manageConcessions', false)
            && eventContentCapsOk()
            && concessionsEnableChangeIsAllowed(resource.data, request.resource.data)
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['concessions', 'updatedAt']));
      allow delete: if isOwnerData(resource.data) || isAdmin();

      match /guests/{guestId} {
        allow read: if canDo(eventId, 'viewGuestList', true) || isAdmin();
        // Autocancelación ("Cancelar mi asistencia"): mismo criterio de
        // confianza que el resto del autoservicio del invitado en este
        // archivo (RSVP, autoedición, reclamo de guestUid) — resolver este
        // (eventId, guestId), un id de Firestore no adivinable ni listable,
        // es la barrera real, no hace falta cuenta ni permiso de
        // coanfitrión. Bloqueado si ya hizo check-in (status == 'checked_in'):
        // esa es la regla de negocio ("ya usaste el pase, no podés
        // autocancelar"), reforzada del lado del contador del evento por
        // guestSelfCancelCountsOk (checkedInCount/occupancyCount fijos).
        allow delete: if canDo(eventId, 'deleteGuests', true) || isAdmin()
          || resource.data.get('status', 'invited') != 'checked_in';
        // Sin companionsWithinLimit: el alta manual del organizador no está
        // sujeta a EventData.maxCompanions (ver GuestData.registrationSource
        // — esta rama nunca la alcanza el autoregistro público, que corre
        // 100% por Cloud Functions con Admin SDK e ignora estas reglas).
        allow create: if canDo(eventId, 'addGuests', true) || isAdmin();
        allow list: if request.query.limit <= 1;
        allow get: if true;
        // Rama del organizador: updateGuest (nombre/apellido/companions/
        // customData/rsvpStatus/lockToken) no restringe campos, igual que
        // antes — solo cambia de qué permiso depende. Check-in/checkout/
        // confirmar pago/habilitar reingreso YA NO tienen rama de cliente
        // propia — ver checkInGuest/checkOutGuest/confirmPaymentAndCheckIn/
        // allowGuestReentry/setGuestPaymentStatus/bulkSetGuestPaymentStatus
        // (Cloud Functions, Admin SDK) — y accessControlFieldsUntouched
        // bloquea que esta rama sin restricción de campos (o isAdmin() más
        // abajo) los toque de rebote. companionsWithinLimitData (grandfathered,
        // solo si el invitado existente es 'self') es la única rama de
        // `update` que valida el tope de acompañantes — es la única que
        // puede tocar `companions` desde el organizador.
        //
        // canDoData/companionsWithinLimitData (vía eventDataFor, ver esa
        // función más arriba) en vez de canDo(eventId,...): cada canDo()
        // internamente hace su propio isOwner+isCoOrganizer+coOrgPerm, 3
        // get()s encadenados por llamada. Antes de la migración de check-in a
        // Cloud Functions, la transacción de cliente que escribía a la vez
        // guests/{guestId} Y events/{eventId} llegó a rechazarse con "maximum
        // of 1000 expressions to evaluate" al sumar el costo de evaluar ESTA
        // regla (hasta 6 llamadas a canDo()) más el de events/{eventId} en la
        // misma transacción — mismo incidente ya documentado y resuelto ahí
        // (ver isOwnerData/canDoData más arriba). La migración a Admin SDK
        // (que ignora estas reglas) elimina esa rama por completo en vez de
        // solo optimizarla.
        allow update: if (canDoData(eventDataFor(eventId), 'editGuests', true) && companionsWithinLimitData(eventDataFor(eventId), request.resource.data, true) && accessControlFieldsUntouched(resource.data, request.resource.data) && guestVersionOk(resource.data, request.resource.data)) ||
          (isAdmin() && accessControlFieldsUntouched(resource.data, request.resource.data) && guestVersionOk(resource.data, request.resource.data)) ||
          // assignGuestToTable (Seating Chart, src/firebase/seating.ts): un
          // coanfitrión con SOLO manageSeating (sin editGuests) puede mover
          // invitados de mesa sin heredar edición completa del invitado —
          // mismo principio que las 2 ramas de campo acotado de arriba.
          (
            canDoData(eventDataFor(eventId), 'manageSeating', true) &&
            request.resource.data.diff(resource.data).affectedKeys().hasOnly(['tableId'])
          ) ||
          // "Dar más tiempo" del organizador (ReconfirmPanel.tsx) — mismo
          // permiso que ya gatea el resto de la gestión de invitados
          // (addGuests, reutilizado también por la lista de espera). Vuelve
          // a poner 'requested' con un plazo nuevo — no valida que el plazo
          // nuevo sea mayor al viejo (el organizador puede necesitar
          // corregir una fecha mal puesta, no solo extenderla).
          (
            canDoData(eventDataFor(eventId), 'addGuests', true) &&
            request.resource.data.diff(resource.data).affectedKeys().hasOnly(['reconfirmStatus', 'reconfirmDeadline']) &&
            request.resource.data.reconfirmStatus == 'requested'
          ) ||
          (
            request.resource.data.diff(resource.data).affectedKeys().hasOnly(['rsvpStatus', 'lockToken']) &&
            guestLockTokensOk(resource.data, request.resource.data.lockToken)
          ) ||
          // El propio invitado reconfirma su asistencia ("Sí, voy a
          // asistir", GuestPass — ver WAITLIST_RECONFIRMATION_ARCHITECTURE.md
          // Fase 2). Solo puede escribir 'confirmed' — 'requested'/'expired'
          // los escribe exclusivamente la Callable/el barrido (Admin SDK,
          // ignora esta regla) o el organizador (rama aparte, "dar más
          // tiempo"). Sin esto, un invitado que nunca fue parte de una
          // campaña (reconfirmStatus ausente) no tiene nada que confirmar,
          // así que se exige que ya exista 'requested' antes.
          (
            request.resource.data.diff(resource.data).affectedKeys().hasOnly(['reconfirmStatus', 'lockToken']) &&
            guestLockTokensOk(resource.data, request.resource.data.get('lockToken', null)) &&
            resource.data.get('reconfirmStatus', null) == 'requested' &&
            request.resource.data.reconfirmStatus == 'confirmed'
          ) ||
          // El propio invitado marca "ya pagué / comprobante enviado"
          // (submitPaymentProof, src/firebase/guests.ts) — solo desde un
          // dispositivo ya reconocido (mismo chequeo de lockTokens que
          // rsvpStatus arriba), solo para transferencia. Sin límite de
          // tiempo (ya no existe el apartado temporal/cronómetro): puede
          // mandarlo cuando quiera mientras no esté ya pagado ni ya tenga un
          // comprobante en revisión. `!= 'paid' && != 'pending_confirmation'`
          // (en vez de enumerar 'unpaid'/'expired') para que un invitado
          // legacy con el valor 'expired' (escrito por el barrido de
          // reservas que este proyecto ya no usa) también pueda mandar su
          // comprobante, igual que cualquier invitado sin pagar — no hace
          // falta migrar esos documentos viejos. paymentNote (número de
          // referencia) sigue siendo OBLIGATORIO — pedido explícito: sin una
          // referencia concreta, el organizador no tiene nada que cotejar
          // contra su resumen bancario para aprobar/rechazar.
          (
            request.resource.data.diff(resource.data).affectedKeys().hasOnly(['paymentStatus', 'paymentNote']) &&
            guestLockTokensOk(resource.data, request.resource.data.get('lockToken', null)) &&
            resource.data.paymentMethod == 'transfer' &&
            resource.data.paymentStatus != 'paid' &&
            resource.data.paymentStatus != 'pending_confirmation' &&
            request.resource.data.paymentStatus == 'pending_confirmation' &&
            request.resource.data.paymentNote is string &&
            request.resource.data.paymentNote.size() > 0 &&
            request.resource.data.paymentNote.size() <= 300
          ) ||
          // El propio invitado edita su información de registro (GuestPass,
          // "Editar mis datos") — mismo gate de lockTokens que las dos ramas
          // de arriba. qrToken/status/checkedIn*/paymentStatus/etc. quedan
          // FUERA de este hasOnly a propósito: si un intento de escritura
          // toca cualquiera de esos campos junto con estos, cae toda la
          // rama (no solo esos campos).
          (
            request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name', 'lastName', 'companions', 'customData', 'menuSelection', 'lockToken', 'version', 'updatedAt']) &&
            guestLockTokensOk(resource.data, request.resource.data.lockToken) &&
            isValidGuestSelfEdit() &&
            guestVersionOk(resource.data, request.resource.data)
          ) ||
          // claimGuestPass (src/firebase/guests.ts): reconoce un dispositivo
          // nuevo agregándolo a `lockTokens` (o inicializándola). Cualquiera
          // puede sumarse a la lista — así es como se "reclama" el pase la
          // primera vez, igual que antes con lockToken == null — siempre que
          // el resultado sea una lista dentro del tope (guestDeviceCap) y el
          // espejo `lockToken` coincida con el último elemento agregado. No
          // valida acá que la rotación LRU de dispositivos viejos sea exacta
          // (eso lo hace el cliente): esta escritura solo habilita al invitado
          // a operar SU PROPIO pase, no afecta check-in, pagos aprobados por
          // el organizador ni a otros invitados.
          (
            request.resource.data.diff(resource.data).affectedKeys().hasOnly(['lockToken', 'lockTokens']) &&
            request.resource.data.lockTokens is list &&
            request.resource.data.lockTokens.size() > 0 &&
            request.resource.data.lockTokens.size() <= guestDeviceCap(resource.data) &&
            request.resource.data.lockToken == request.resource.data.lockTokens[request.resource.data.lockTokens.size() - 1]
          ) ||
          // Vincula este pase a la cuenta autenticada — ver claimGuestOwnership
          // (src/firebase/guests.ts) y reclaimInvitationsByEmail
          // (src/firebase/invitationRecovery.ts), los dos caminos que llegan
          // acá: abrir el pase ya logueado, o encontrarlo desde otro
          // dispositivo cruzando el email verificado de la cuenta contra
          // guestContacts. "Primero en reclamarlo, gana": solo mientras el
          // pase no tenga ya un dueño (resource.data.guestUid ausente o
          // null) — una vez vinculado, ninguna otra cuenta puede pisarlo.
          //
          // No exige lockToken acá: a diferencia de las ramas de arriba,
          // reasignar un campo al mismo valor que ya tenía no aparece en
          // diff().affectedKeys() (Firestore compara VALORES, no cuáles
          // claves mandó el cliente), así que "el cliente reenvía el
          // lockToken ya reconocido" no es una prueba real de posesión —
          // cualquiera podría omitirlo y heredar el valor ya guardado sin
          // conocerlo. La barrera real de esta rama es la MISMA que ya
          // protege leer/operar el resto del invitado en todo este archivo:
          // resolver el (eventId, guestId) correcto, un id aleatorio de
          // Firestore no adivinable. La ruta de descubrimiento NUEVA
          // (encontrar un guestId que la cuenta nunca tuvo) es
          // guestContacts (ver su `allow list` más abajo), que sí exige
          // email_verified y coincidencia exacta — esa es la puerta que
          // importa proteger, no esta escritura puntual.
          (
            request.auth != null &&
            resource.data.get('guestUid', null) == null &&
            request.resource.data.diff(resource.data).affectedKeys().hasOnly(['guestUid']) &&
            request.resource.data.guestUid == request.auth.uid
          );
      }

      // email/phone del invitado: antes nunca público. Ahora `get` por id
      // conocido es público — mismo modelo de confianza que ya tiene
      // guests/{guestId} (`allow get: if true`): quien tiene el link /pass
      // ya puede leer el resto del invitado. `list`/búsqueda sigue vedada al
      // público — nadie puede enumerar la colección ni buscar por campo,
      // solo pedir el contacto de un guestId puntual ya resuelto vía
      // guests/{guestId}.
      match /guestContacts/{guestId} {
        allow get: if true;
        allow list: if canDo(eventId, 'viewGuestList', true) || isAdmin();
        // Mismo criterio de autocancelación que guests/{guestId} `allow
        // delete` de arriba (deleteGuest borra ambos documentos en el mismo
        // batch) — el status vive en el guest hermano, no acá, de ahí el
        // get().
        allow delete: if canDo(eventId, 'deleteGuests', true) || isAdmin()
          || get(/databases/$(database)/documents/events/$(eventId)/guests/$(guestId)).data.get('status', 'invited') != 'checked_in';
        // canDo(...,'addGuests',...) además de editGuests: agregar un
        // invitado (addGuest/addGuestsBulk/import CSV) puede incluir su
        // teléfono/email en la MISMA operación de alta — antes, un
        // coanfitrión con addGuests:true pero editGuests:false (combinación
        // válida, ej. "solo puede sumar invitados nuevos") no podía guardar
        // ese contacto: el guest se creaba pero el batch entero fallaba en
        // el `set` de guestContacts, dejando el teléfono/email perdido.
        allow create: if canDo(eventId, 'editGuests', true) || canDo(eventId, 'addGuests', true) || isAdmin()
          // Primer guardado de contacto del propio invitado (p.ej. un
          // invitado de lista, agregado sin teléfono, que ahora carga el
          // suyo por primera vez) — aplica a cualquier invitado con pase,
          // venga de lista o autoregistro.
          || (
            request.resource.data.keys().hasOnly(['email', 'phone', 'phoneCountry', 'lockToken', 'whatsappConsent']) &&
            isValidPublicGuestContact() &&
            guestSelfEditContactLockOk(eventId, guestId)
          );
        allow update: if canDo(eventId, 'editGuests', true) || isAdmin()
          || (
            request.resource.data.diff(resource.data).affectedKeys().hasOnly(['email', 'phone', 'phoneCountry', 'lockToken', 'whatsappConsent']) &&
            isValidPublicGuestContact() &&
            guestSelfEditContactLockOk(eventId, guestId)
          );
      }

      match /checkins/{checkinId} {
        // También lo lee Reports (viewReports) — no solo el escáner.
        allow read: if canDo(eventId, 'scanQr', true) || canDo(eventId, 'viewReports', true) || isAdmin();
        // Los únicos 3 escritores (check-in, check-out, bloqueo por salida
        // definitiva) son Cloud Functions (Admin SDK, ignora esta regla) —
        // ver functions/src/checkin/. Ningún cliente crea estos docs directo.
        allow create: if false;
        allow delete: if isOwner(eventId) || isAdmin();
        allow update: if false;
      }

      // Mesas del Seating Chart (src/firebase/seating.ts). También lectura
      // para viewReports: Reports/Anfitrión en Vivo pueden mostrar ocupación
      // por mesa sin requerir manageSeating.
      match /tables/{tableId} {
        allow read: if canDo(eventId, 'manageSeating', true) || canDo(eventId, 'viewReports', true) || isAdmin();
        allow create, update: if (canDo(eventId, 'manageSeating', true) || isAdmin())
          && request.resource.data.name is string
          && request.resource.data.name.size() > 0
          && request.resource.data.name.size() <= 60
          && request.resource.data.capacity is int
          && request.resource.data.capacity > 0
          && request.resource.data.shape in ['round', 'rectangular', 'square', 'custom']
          && request.resource.data.sortOrder is number;
        allow delete: if canDo(eventId, 'manageSeating', true) || isAdmin();
      }

      // Catálogo del módulo de comida/bebida (ver RFC §4.2). Lectura pública
      // para cualquier invitado del evento (un evento 'list' de todas formas
      // es legible por cualquiera que tenga el link del GuestPass, igual
      // que el resto del contenido del evento en este archivo) más el propio staff/organizador
      // para poder armar el pedido/administrar el catálogo. `delete` real
      // nunca — solo `status: 'archived'` (soft delete, ver comentario de
      // ConcessionItem.status).
      match /concessionsCatalog/{itemId} {
        // Público dentro de un evento con el módulo activo — es un menú, no
        // hay nada que ocultar acá (mismo criterio que `wall`/`photos`, ya
        // `allow read: if true` en este archivo).
        allow read: if concessionsEnabled(eventDataFor(eventId));
        allow create: if concessionsEnabled(eventDataFor(eventId))
          && (canDo(eventId, 'manageConcessions', false) || isAdmin())
          && isValidConcessionItem(request.resource.data);
        // Dos ramas de `update`: el organizador/coanfitrión con
        // manageConcessions edita cualquier campo (catálogo, precios, stock);
        // el encargado de preparación SOLO puede tocar `status` (agotado
        // manual, ver RFC §11.4) — nunca precio, nombre ni stock. El
        // encargado de caja no tiene ninguna rama acá (no administra
        // catálogo).
        // Checkout (reserva/descuento de stock) y cancelación de un pedido
        // (liberación de stock) ya NO tienen rama de cliente acá — ambas
        // corren en Cloud Functions con Admin SDK (ver
        // createConcessionOrder/cancelConcessionOrder), que bypassean estas
        // reglas. `stockRemaining`/`soldCount` quedan así reservados
        // exclusivamente al organizador (vía isValidConcessionItem) y al
        // servidor.
        allow update: if concessionsEnabled(eventDataFor(eventId)) && (
          ((canDo(eventId, 'manageConcessions', false) || isAdmin()) && isValidConcessionItem(request.resource.data))
          || (
            isConcessionsPrep(eventDataFor(eventId))
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'updatedAt'])
            && request.resource.data.status in ['active', 'outOfStock']
          )
        );
        allow delete: if false;
      }

      // Pedidos — fuente de verdad de dinero/comprobante/pago (ver RFC §4.3).
      // `get` es bearer-link (mismo modelo de confianza que guests/{guestId}:
      // el orderId es un id aleatorio de Firestore no adivinable, y es lo que
      // el propio invitado usa para ver el estado de SU pedido en tiempo
      // real, sin necesitar cuenta). `list` sí está acotado: solo
      // organizador/staff con permiso, o una cuenta vinculada consultando sus
      // propios pedidos entre dispositivos (ver claimGuestOwnership/guestUid).
      match /concessionsOrders/{orderId} {
        allow get: if concessionsEnabled(eventDataFor(eventId));
        allow list: if concessionsEnabled(eventDataFor(eventId)) && (
          canDo(eventId, 'manageConcessions', false) || canDo(eventId, 'confirmPayments', false) || isAdmin()
          || (
            request.auth != null && request.query.limit <= 50 &&
            get(/databases/$(database)/documents/events/$(eventId)/guests/$(resource.data.guestId)).data.get('guestUid', null) == request.auth.uid
          )
        );
        // El pedido se crea SIEMPRE vía la Callable `createConcessionOrder`
        // (Admin SDK, bypassea estas reglas) — nunca directo desde el
        // cliente, único punto donde antes se podía fabricar
        // subtotalMinorUnits/totalMinorUnits sin que coincidieran con el
        // catálogo real (ver FIRESTORE_RULES_SIMPLIFICATION_AUDIT.md Fase B).
        allow create: if false;
        allow update: if concessionsEnabled(eventDataFor(eventId)) && (
          // Invitado dueño: cancelar su propio pedido, solo mientras no esté
          // ya confirmado. Ya NO puede subir comprobante/referencia (ver
          // rediseño "Ventas del evento" §14-16) — tanto efectivo como
          // transferencia se validan en persona en caja, así que esta rama
          // solo necesita autorizar la transición a 'cancelled'.
          // `paymentNote`/`paymentProofUrl` quedan fuera de
          // `affectedKeys().hasOnly(...)` a propósito: ya no hay ninguna
          // escritura legítima de cliente que los toque.
          (
            isGuestOrderActor(eventId, resource.data.guestId, request.resource.data.get('lockToken', null))
            && resource.data.paymentPhase in ['awaiting_payment', 'rejected']
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['paymentPhase', 'cancelReason', 'lockToken', 'updatedAt'])
            && request.resource.data.paymentPhase == 'cancelled'
            && request.resource.data.cancelReason == 'guest_cancelled'
          )
          // Organizador/coanfitrión con manageConcessions o confirmPayments,
          // o admin: confirmar, rechazar, cancelar. Mismo nivel de confianza
          // que ya tienen sobre guests/{guestId} para el pago de entrada —
          // sin acotar campos acá, igual criterio que esa rama.
          || canDo(eventId, 'confirmPayments', false) || canDo(eventId, 'manageConcessions', false) || isAdmin()
          // Encargado de caja (rol nuevo, sin ser coorganizador): mismo nivel
          // de confianza que confirmPayments sobre este documento — valida
          // pagos en persona en el evento, sin acceso a nada más del evento.
          || isConcessionsCashier(eventDataFor(eventId))
        );
        allow delete: if false;
      }

      // Proyección de cocina — SIN dinero, SIN comprobante (ver RFC §4.3).
      // Mismo id que el ConcessionOrder del que es espejo. El encargado de
      // preparación solo puede leer pedidos ya pagados (`fulfillmentStatus`
      // fuera de 'not_ready') y solo puede avanzar el estado de preparación
      // — nunca tocar montos porque acá ni siquiera existen. El encargado de
      // caja NO tiene acceso acá (no necesita saber qué preparar).
      match /concessionsFulfillment/{orderId} {
        allow get: if concessionsEnabled(eventDataFor(eventId)) && (
          canDo(eventId, 'manageConcessions', false) || canDo(eventId, 'confirmPayments', false) || isAdmin()
          || (isConcessionsPrep(eventDataFor(eventId)) && resource.data.fulfillmentStatus in ['queued', 'preparing', 'ready', 'delivered'])
          // Bearer-link: el invitado dueño del pedido (o cualquier otra
          // rama ya cubierta arriba) puede leerlo por id conocido — un
          // encargado de caja SIN rol de preparación queda excluido a
          // propósito (no necesita saber qué preparar).
          || !isConcessionsStaffMember(eventDataFor(eventId))
        );
        allow list: if concessionsEnabled(eventDataFor(eventId)) && (
          canDo(eventId, 'manageConcessions', false) || canDo(eventId, 'confirmPayments', false) || isAdmin()
          || (isConcessionsPrep(eventDataFor(eventId)) && resource.data.fulfillmentStatus in ['queued', 'preparing', 'ready', 'delivered'])
        );
        // Se crea SIEMPRE junto con concessionsOrders, dentro de la misma
        // transacción de checkout de la Callable `createConcessionOrder`
        // (Admin SDK, bypassea estas reglas) — nunca directo desde el
        // cliente.
        allow create: if false;
        allow update: if concessionsEnabled(eventDataFor(eventId)) && (
          canDo(eventId, 'manageConcessions', false) || isAdmin()
          // confirmPayments: puede sacar un pedido de 'not_ready' (mismo
          // actor que confirma el pago en concessionsOrders, ver
          // confirmConcessionOrderPayment) además de avanzar cualquier otro
          // paso de preparación.
          || (
            canDo(eventId, 'confirmPayments', false)
            && resource.data.fulfillmentStatus in ['not_ready', 'queued', 'preparing', 'ready']
            && request.resource.data.fulfillmentStatus in ['queued', 'preparing', 'ready', 'delivered', 'cancelled']
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['fulfillmentStatus', 'updatedAt', 'deliveredAt'])
          )
          // Encargado de preparación: JAMÁS puede tocar un pedido en
          // 'not_ready' (ni siquiera puede leerlo, ver `allow get` arriba) —
          // solo avanza o retrocede la preparación de un pedido YA pagado.
          // 'cancelled' fuera de su set de destino a propósito: cancelar
          // implica liberar stock reservado (ver isValidConcessionStockRelease
          // en concessionsCatalog), una operación de dinero/inventario que
          // sigue reservada a confirmPayments/manageConcessions/admin — sin
          // esta exclusión, el encargado de preparación podía dejar un
          // pedido "cancelado" en la cocina sin que nadie liberara ese stock
          // ni tocara el pedido real en concessionsOrders. Sin esta
          // distinción, también podría "adivinar" un orderId y escribir un
          // update a ciegas (Firestore no exige haber leído el doc antes de
          // escribirlo) y así calificar como preparado/entregado un pedido
          // que nunca se pagó.
          || (
            isConcessionsPrep(eventDataFor(eventId))
            && resource.data.fulfillmentStatus in ['queued', 'preparing', 'ready']
            && request.resource.data.fulfillmentStatus in ['queued', 'preparing', 'ready', 'delivered']
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['fulfillmentStatus', 'updatedAt', 'deliveredAt'])
          )
        );
        allow delete: if false;
      }

      // Bitácora de envíos automáticos (push, recordatorios de RSVP,
      // lista de espera/reconfirmación) — escrita
      // ÚNICAMENTE por Cloud Functions vía Admin SDK (bypassa rules), nunca
      // desde el cliente. Los tres pipelines Spark-era (scripts/*.mjs +
      // GitHub Actions cron) ya migraron acá — ver
      // NOTIFICATIONS_CONSOLIDATION_ARCHITECTURE.md, Fases 1-3. El panel
      // "Historial de envíos" que dejaba leer esto al organizador se quitó
      // del Dashboard del Evento (rediseño) — solo admin la lee ahora,
      // vía la regla collectionGroup de más abajo (Centro de Control).
      match /sendLog/{logId} {
        allow read: if isAdmin();
        allow write: if false;
      }

      // Invitaciones de coorganizador por enlace/código (rediseño del
      // Dashboard del Evento — createCoOrganizerInvite.ts/
      // acceptCoOrganizerInvite.ts). El token es la única barrera de acceso
      // real (nadie puede listarlos ni adivinar uno sin conocerlo), así que
      // ni siquiera el organizador puede leerlos directo: se crean y se
      // canjean ÚNICAMENTE vía esas dos Cloud Functions (Admin SDK, bypassa
      // estas reglas) — el navegador nunca lee ni escribe esta subcolección.
      match /coOrganizerInvites/{token} {
        allow read, write: if false;
      }

      // Invitaciones de encargado de "Ventas del evento" por enlace/QR
      // (createConcessionsStaffInvite.ts/acceptConcessionsStaffInvite.ts) —
      // mismo criterio que coOrganizerInvites arriba: el token es la única
      // barrera de acceso real, se crean y canjean ÚNICAMENTE vía esas dos
      // Cloud Functions (Admin SDK, bypassa estas reglas).
      match /concessionsStaffInvites/{token} {
        allow read, write: if false;
      }

      // Invitaciones unificadas de colaborador (Fase 3 de
      // ROLES_PERMISSIONS_REDESIGN.md — createCollaboratorInvite.ts/
      // acceptCollaboratorInvite.ts), reemplazo futuro de coOrganizerInvites/
      // concessionsStaffInvites arriba (que se conservan mientras dure la
      // migración). Mismo criterio: el token es la única barrera de acceso
      // real, se crean y canjean ÚNICAMENTE vía esas dos Cloud Functions
      // (Admin SDK, bypassa estas reglas).
      match /collaboratorInvites/{token} {
        allow read, write: if false;
      }

      // Cola de notificaciones desacoplada (Feature 5: push notifications) —
      // el navegador solo ENCOLA
      // (create, status siempre 'queued'); el trigger de Firestore
      // onNotificationQueued (functions/src/triggers/onNotificationQueued.ts,
      // Admin SDK) es quien transiciona status y envía — ver
      // NOTIFICATIONS_CONSOLIDATION_ARCHITECTURE.md Fase 1.
      // scripts/send-notifications.mjs queda solo como respaldo manual
      // (workflow_dispatch) durante el período de transición. Sin `read`
      // para el cliente: hoy no hay ninguna UI que necesite listar la cola,
      // solo el trigger (que corre con Admin SDK y no pasa por estas reglas).
      //
      // Dos formas de encolar, con autorización MUY distinta:
      // - 'payment_confirmed'/'event_updated': dispara una acción YA
      //   autenticada del organizador (confirmar pago, marcar check-in,
      //   editar evento) — mismo permiso que esa acción, sin fricción extra.
      // - 'rsvp_new': lo dispara un INVITADO ANÓNIMO (setGuestRsvp, por
      //   qrToken, sin auth de organizador) — acá la única barrera real
      //   contra spam de push al organizador es esta regla: recipientUid
      //   tiene que ser exactamente el dueño del evento (no cualquier uid a
      //   elección de quien escribe) y el resto de los campos, una whitelist
      //   exacta con tipos/tamaños acotados.
      match /notificationQueue/{notifId} {
        allow read: if false;
        allow create: if
          (
            (canDo(eventId, 'confirmPayments', true) || canDo(eventId, 'scanQr', true) || canDo(eventId, 'editEvent', true))
            && request.resource.data.eventId == eventId
            && request.resource.data.type in ['payment_confirmed', 'event_updated']
            && request.resource.data.status == 'queued'
            && request.resource.data.payload is map
            && request.resource.data.payload.title is string && request.resource.data.payload.title.size() <= 150
            && request.resource.data.payload.body is string && request.resource.data.payload.body.size() <= 500
          )
          ||
          (
            request.resource.data.eventId == eventId
            && request.resource.data.type == 'rsvp_new'
            && request.resource.data.recipientUid == eventDataFor(eventId).ownerId
            && request.resource.data.status == 'queued'
            && request.resource.data.keys().hasOnly(['type', 'recipientUid', 'eventId', 'payload', 'channels', 'status', 'createdAt'])
            && request.resource.data.payload is map
            && request.resource.data.payload.title is string && request.resource.data.payload.title.size() <= 150
            && request.resource.data.payload.body is string && request.resource.data.payload.body.size() <= 500
            && request.resource.data.channels is list && request.resource.data.channels.size() <= 3
          );
        allow update, delete: if false;
      }

      // Jobs de importación masiva de invitados por CSV, procesados en
      // background vía Cloud Tasks (ver functions/src/csvImport/,
      // functions/src/callable/startCsvImport.ts,
      // functions/src/tasks/processCsvImportChunk.ts). El cliente NUNCA
      // escribe acá — ni siquiera para encolar, a diferencia de
      // notificationQueue de arriba: startCsvImport (Admin
      // SDK, bypassa estas reglas) crea el job y sus chunks de una, y
      // processCsvImportChunk es quien avanza el estado. El organizador solo
      // LEE para mostrar una barra de progreso vía onSnapshot mientras sigue
      // usando el resto de la app.
      match /csvImportJobs/{jobId} {
        allow read: if canDo(eventId, 'addGuests', true) || isAdmin();
        allow write: if false;

        // Cada chunk trae las filas crudas del CSV (incluye email/teléfono
        // sin validar todavía) — mismo permiso de lectura que el job
        // (addGuests), solo para diagnóstico si hace falta ver por qué se
        // rechazó una fila puntual.
        match /chunks/{chunkId} {
          allow read: if canDo(eventId, 'addGuests', true) || isAdmin();
          allow write: if false;
        }
      }

      // Lista de espera (WAITLIST_RECONFIRMATION_ARCHITECTURE.md). Mismo
      // patrón de lectura por token que `guests` (allow get: if true — el id
      // del documento no es adivinable ni listable; allow list acotado a
      // limit(1) habilita `where('waitlistToken','==',token)` sin permitir
      // enumerar el resto de la fila, protegiendo la privacidad de quién más
      // está esperando). Segunda rama, igual que `guests` (ver su `allow
      // list` más abajo): el organizador/coanfitrión con `viewGuestList`
      // (o admin) puede listar la fila completa sin el límite de 1 — es la
      // consulta real que usa WaitlistPanel.tsx (subscribeToWaitlist, sin
      // limit()) para mostrar el panel. Bug real encontrado en producción:
      // sin esta rama, esa consulta siempre devolvía permission-denied y el
      // panel quedaba en silencio como si nadie estuviera esperando.
      match /waitlist/{entryId} {
        allow get: if true;
        allow list: if request.query.limit <= 1
          || canDo(eventId, 'viewGuestList', true) || isAdmin();
        allow create: if canJoinWaitlist(eventId, request.resource.data)
          || canOrganizerCreateWaitlistEntry(eventId, request.resource.data)
          || isAdmin();
        // Únicas dos escrituras que puede hacer un cliente (organizador/
        // coanfitrión con permiso de gestión de invitados, mismo permiso que
        // ya gatea addGuests — la lista de espera es una extensión de
        // "gestionar invitados", no una categoría de permiso nueva): mover
        // al frente de la fila (solo puede SUBIR priorityBoost, nunca
        // bajarlo, y solo mientras la entrada sigue 'waiting') y quitar a
        // alguien de la fila (waiting→removed). Todo lo demás — ofertar,
        // vencer, promover, declinar — es exclusivo de Cloud Functions vía
        // Admin SDK, que ignora estas reglas; por eso ninguna rama de acá
        // abajo puede tocar `offerToken`/`offerExpiresAt`/`promotedGuestId`/
        // `promotionReason`, ni escribir `status: 'offered'/'promoted'/
        // 'expired'/'declined'`.
        allow update: if (canDoData(eventDataFor(eventId), 'addGuests', true) || isAdmin())
          && (
            (
              request.resource.data.diff(resource.data).affectedKeys().hasOnly(['priorityBoost'])
              && resource.data.status == 'waiting'
              && request.resource.data.priorityBoost > resource.data.priorityBoost
            )
            || (
              request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status'])
              && resource.data.status == 'waiting'
              && request.resource.data.status == 'removed'
            )
          );
        allow delete: if false;
      }

      match /wall/{messageId} {
        allow read: if true;
        // Sancionado (baneo o restricción de comentarios, global o de este
        // evento en particular) → bloqueado server-side, no solo en la UI.
        // Un invitado sin sesión no pasa por este chequeo (no hay uid que
        // sancionar) — mismo límite que el resto de las protecciones
        // anti-abuso de este archivo para tráfico anónimo.
        allow create: if isValidWallMessage(eventId) && (request.auth == null || !commentsBlocked(eventId));
        allow update: if canDo(eventId, 'moderateWall', true) || isAdmin()
          // Auditoría F2/F11: reaccionar ya no toca este documento con la
          // identidad del reactor — el doc espejo (ver match /reactions/
          // {token} más abajo) es la fuente de verdad de CADA reacción, sin
          // tope de tamaño posible. Acá solo se valida el movimiento de los
          // contadores agregados, acotado a ±1 por escritura
          // (reactionCountOk/reactionCountsByTypeOk) — nadie puede inflar el
          // conteo sin pasar por una reacción real en la subcolección.
          || (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['reactionCount', 'reactionCountsByType'])
              && reactionCountOk(resource.data, request.resource.data)
              && reactionCountsByTypeOk(resource.data, request.resource.data))
          // Responder: mismo criterio de autorización que crear un mensaje
          // (ver isValidWallReplyAppend) — el anfitrión y cualquier invitado
          // no sancionado usan esta misma rama, no hay una ruta aparte.
          || (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['replies'])
              && isValidWallReplyAppend(eventId))
          // Borrar el propio mensaje (deleteWallMessage hace un soft-delete
          // vía update, `deleted: true` — no un `delete` real). Solo se
          // puede verificar para un autor CON SESIÓN cuyo `authorToken`
          // quedó igual a su uid al postear (ver `authorToken` en
          // EventWall.tsx) — un invitado sin cuenta no tiene ninguna
          // identidad que estas reglas puedan comprobar del lado servidor,
          // así que no puede autoborrarse acá (mismo límite ya documentado
          // arriba para authorRole/postWall). Solo permite marcar `deleted`,
          // y solo a `true` (no "revivir" un mensaje ya borrado por esta
          // vía).
          || (request.auth != null && request.auth.uid == resource.data.authorToken
              && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['deleted'])
              && request.resource.data.deleted == true);
        allow delete: if canDo(eventId, 'moderateWall', true) || isAdmin();

        // Auditoría F2/F11: doc espejo de cada reacción, un documento por
        // reactor — sin tope de tamaño posible, porque nunca crece un único
        // documento (a diferencia del viejo mapa `reactions` embebido, ya
        // retirado — ver reactToContent en interactions.ts).
        match /reactions/{token} {
          allow read: if true;
          allow create, update: if isValidReactionDoc();
          allow delete: if true;
        }
      }

      // Álbum de fotos del evento. Visible para cualquiera que conozca el
      // eventId (mismo criterio que el muro y el pase del invitado).
      // Solo puede subir fotos quien tenga un qrToken válido (campo que se
      // escribe en el doc) — el organizador/co-org puede borrar cualquier foto.
      match /photos/{photoId} {
        allow read: if true;
        allow create: if request.resource.data.url is string
          && request.resource.data.url.size() > 0
          && request.resource.data.url.size() <= 500
          && request.resource.data.authorName is string
          && request.resource.data.authorName.size() > 0
          && request.resource.data.authorName.size() <= 60
          && request.resource.data.authorToken is string
          && request.resource.data.authorToken.size() > 0
          && request.resource.data.authorToken.size() <= 100
          && (!('caption' in request.resource.data)
              || (request.resource.data.caption is string
                  && request.resource.data.caption.size() <= 120))
          && (request.auth == null || !photosBlocked(eventId));
        // Destacar/quitar destacado (mismo concepto que pinWallMessage del
        // muro) — el bypass de organizador/admin sigue acotado solo a este
        // campo, para que esta apertura no habilite editar url/authorName/
        // etc. de una foto ya subida (a diferencia de `wall`, donde
        // isOwnerOrCoOrg/isAdmin puede tocar cualquier campo — acá se
        // mantiene la postura más restrictiva que ya tenía `photos`).
        //
        // Reacciones y respuestas (fotos Y las "historias", que son las
        // mismas fotos vistas agrupadas por autor — ver StoriesBar.tsx)
        // reutilizan exactamente las mismas ramas que ya validaban esto para
        // `wall` — ver comentario ahí (reactionCountOk/reactionCountsByTypeOk,
        // isValidWallReplyAppend para `replies`).
        allow update: if ((canDo(eventId, 'moderateWall', true) || isAdmin())
              && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['pinned'])
              && request.resource.data.pinned is bool)
          || (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['reactionCount', 'reactionCountsByType'])
              && reactionCountOk(resource.data, request.resource.data)
              && reactionCountsByTypeOk(resource.data, request.resource.data))
          || (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['replies'])
              && isValidWallReplyAppend(eventId));
        allow delete: if canDo(eventId, 'moderateWall', true) || isAdmin();

        // Auditoría F2/F11 — mismo doc espejo que wall/{messageId}/reactions,
        // ver comentario ahí.
        match /reactions/{token} {
          allow read: if true;
          allow create, update: if isValidReactionDoc();
          allow delete: if true;
        }
      }
    }

    // Consulta collectionGroup para recuperación entre dispositivos (ver
    // reclaimInvitationsByEmail en src/firebase/invitationRecovery.ts) — es
    // la ÚNICA forma en que un cliente puede DESCUBRIR un guestId que nunca
    // tuvo, cruzando su propio email VERIFICADO contra guestContacts de
    // CUALQUIER evento. A diferencia de guests/{guestId} (público por id ya
    // conocido), enumerar/buscar en guestContacts está vedado salvo esta
    // excepción puntual.
    //
    // Declarado como match de colección aparte con `{path=**}` (en vez de
    // agregar esta condición al `allow list` de events/{eventId}/guestContacts
    // de arriba) porque Firestore evalúa la "demostrabilidad" de una consulta
    // `list` de forma distinta para collection group queries: solo reconoce
    // la consulta como segura de antemano (sin tener que leer cada documento)
    // cuando la regla que la autoriza está declarada en un match de colección
    // completo como este — verificado con el emulador, la misma condición
    // dentro del match anidado por evento rechazaba la consulta entera con
    // "No matching allow statements" pese a que el email coincidía.
    //
    // Firestore exige que la query en sí traiga un where('email','==', ese
    // mismo valor) para poder demostrar, sin leer cada documento, que ningún
    // resultado puede pertenecer a otra persona (así evalúa reglas de `list`
    // — no filtra resultados después, deniega la consulta entera si no puede
    // probarlo de antemano). email_verified exige haber confirmado la
    // casilla (o haber iniciado sesión con Google, que ya lo verifica) — sin
    // esto, cualquier cuenta podría enumerar nombres/teléfonos/emails de
    // TODOS los invitados de TODOS los eventos con solo tipear cualquier
    // email ajeno.
    //
    // `.lower()` va del lado de request.auth.token.email (un valor único por
    // request, calculable de antemano) y NO del lado de resource.data.email
    // (verificado con el emulador: aplicar .lower() al campo del documento
    // ahí rompe la demostrabilidad y Firestore rechaza la consulta entera).
    // Por eso el cliente debe consultar siempre con el email en minúsculas
    // (ver reclaimInvitationsByEmail) — coincide con cómo capacity.ts/
    // guests.ts normalizan `email` al escribir un guestContacts nuevo desde
    // este cambio en adelante. Documentos históricos con el email guardado
    // en otra capitalización no matchean por esta vía (limitación conocida,
    // sin migración — ver esos archivos).
    match /{path=**}/guestContacts/{guestId} {
      allow list: if request.auth != null &&
        request.auth.token.get('email_verified', false) == true &&
        request.query.limit <= 25 &&
        resource.data.email == request.auth.token.email.lower();
    }

    // Centro de Control del admin (Alertas inteligentes + Actividad en
    // vivo, ver src/firebase/adminAlerts.ts y adminActivity.ts) — 4 lecturas
    // `collectionGroup` nuevas, todas gateadas por `isAdmin()` puro (a
    // diferencia de guestContacts arriba, esta condición NO depende de
    // comparar resource.data contra el query, así que es demostrable de
    // antemano sin exigir ningún where() particular, solo un limit()
    // razonable). Declaradas acá (match de colección completo) en vez de
    // como condición extra en las reglas anidadas por-evento de más arriba,
    // por el mismo motivo documentado en el comentario de guestContacts:
    // una regla anidada bajo events/{eventId}/... nunca cubre una query
    // collectionGroup(), sin importar la condición. Son aditivas: no
    // reemplazan ni modifican ninguna regla anidada existente (sendLog,
    // notificationQueue, csvImportJobs, guests siguen sirviendo sus
    // lecturas por-evento exactamente igual que antes).
    match /{path=**}/sendLog/{logId} {
      allow list: if isAdmin() && request.query.limit <= 20;
    }
    match /{path=**}/notificationQueue/{notifId} {
      allow list: if isAdmin() && request.query.limit <= 20;
    }
    match /{path=**}/csvImportJobs/{jobId} {
      allow list: if isAdmin() && request.query.limit <= 20;
    }
    match /{path=**}/guests/{guestId} {
      allow list: if isAdmin() && request.query.limit <= 20;
    }

    // Analítica de plataforma del admin (src/firebase/platformUsage.ts) — 2
    // lecturas `collectionGroup` más, mismo criterio que el bloque de arriba
    // (aditivas, `isAdmin()` puro, no tocan las reglas anidadas por-evento de
    // `waitlist`/`concessionsOrders` más arriba en el archivo). Sin el
    // `limit()` del bloque anterior: son consultas de agregación
    // (getCountFromServer), que no declaran `limit` — exigirlo las rechazaría
    // siempre.
    match /{path=**}/waitlist/{entryId} {
      allow list: if isAdmin();
    }
    match /{path=**}/concessionsOrders/{orderId} {
      allow list: if isAdmin();
    }
  }
}
