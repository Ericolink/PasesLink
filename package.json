{
  "name": "app-pases",
  "private": true,
  "version": "1.28.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:staging": "vite --mode staging",
    "build": "tsc -b && vite build",
    "build:staging": "tsc -b && vite build --mode staging",
    "lint": "eslint .",
    "knip": "knip",
    "preview": "vite preview",
    "test": "vitest run",
    "test:firebase": "firebase emulators:exec --only firestore --project demo-paselink-test \"vitest run --config vitest.firebase.config.ts\"",
    "test:functions": "firebase emulators:exec --only firestore --project demo-paselink-test \"npm --prefix functions run test\"",
    "backup:firestore": "node scripts/backup-firestore.mjs",
    "restore:firestore": "node scripts/restore-firestore.mjs",
    "firestore:explain": "node scripts/explain-query.mjs",
    "backfill:checkins-by-hour": "node scripts/backfill-checkins-by-hour.mjs",
    "backfill:reactions-subcollection": "node scripts/backfill-reactions-subcollection.mjs",
    "backfill:walkin-net-count": "node scripts/backfill-walkin-net-count.mjs"
  },
  "dependencies": {
