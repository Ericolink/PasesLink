{
  "rule": [
    {
      "action": { "type": "Delete" },
      "condition": {
        "age": 30,
        "matchesPrefix": ["firestore-backups/daily/", "firestore-backups/metadata/daily/"]
      }
    },
    {
      "action": { "type": "Delete" },
      "condition": {
        "age": 84,
        "matchesPrefix": ["firestore-backups/weekly/", "firestore-backups/metadata/weekly/"]
      }
    },
    {
      "action": { "type": "Delete" },
      "condition": {
        "age": 365,
        "matchesPrefix": ["firestore-backups/monthly/", "firestore-backups/metadata/monthly/"]
      }
    },
    {
      "action": { "type": "SetStorageClass", "storageClass": "NEARLINE" },
      "condition": {
        "age": 30,
        "matchesPrefix": ["firestore-backups/weekly/", "firestore-backups/monthly/"]
      }
    },
    {
      "action": { "type": "SetStorageClass", "storageClass": "COLDLINE" },
      "condition": {
        "age": 90,
        "matchesPrefix": ["firestore-backups/monthly/"]
      }
    }
  ]
}
