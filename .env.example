VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
# Google Analytics (Firebase Analytics) - Firebase Console > Project Settings
# > General > tu app web > "Añadir Google Analytics" si el proyecto todavía
# no lo tiene habilitado. Copiar el "ID de métricas" (empieza con "G-").
# Sin esta variable, initAnalytics() (src/lib/analytics.ts) no hace nada — la
# app funciona igual, simplemente sin reportar nada a Analytics.
VITE_FIREBASE_MEASUREMENT_ID=
# Push notifications (Feature 5) - clave VAPID de Firebase Console > Project
# Settings > Cloud Messaging > Web Push certificates ("Generate key pair").
# Requiere haber activado Cloud Messaging (Firebase Cloud Messaging API) en
# ese mismo proyecto de Firebase primero. Sin esta variable,
# requestPushPermission() falla con un mensaje claro en vez de romper la app.
VITE_FIREBASE_VAPID_KEY=

# Cloudinary (foto de perfil) - https://cloudinary.com/
VITE_CLOUDINARY_CLOUD_NAME=
VITE_CLOUDINARY_UPLOAD_PRESET=

# OpenRouteService (recordatorio de salida: tiempo estimado de viaje) -
# https://openrouteservice.org/dev/#/signup — plan gratis (2000 req/día), sin
# tráfico en vivo. Restringir por dominio en el dashboard antes de producción,
# ya que la key viaja en el bundle del cliente (no hay backend que la oculte).
# Sin esta variable, la tarjeta de "hora de salida recomendada" del pase
# simplemente no aparece (degradación elegante, no rompe nada). El clima de
# esa misma tarjeta usa Open-Meteo, que no requiere API key.
VITE_OPENROUTESERVICE_API_KEY=

# App Check / anti-bot (opcional) - clave reCAPTCHA v3 desde
# https://www.google.com/recaptcha/admin (tipo "v3"). Sin esta variable la app
# funciona igual, simplemente sin protección anti-bot en los formularios públicos.
# Después de configurarla, activar "Enforce" en Firebase Console > App Check > Firestore.
VITE_RECAPTCHA_SITE_KEY=

# Sentry (error monitoring + performance + session replay) - https://sentry.io
# Crear un proyecto tipo "React", plan Developer (gratis). Sin VITE_SENTRY_DSN
# la app funciona igual, simplemente sin reportar nada a Sentry (initSentry()
# no hace nada). El DSN es público por diseño (como el resto de la config de
# Firebase/Cloudinary de arriba) — lo que protege la cuenta es el dashboard,
# no que el valor esté oculto.
VITE_SENTRY_DSN=
# Estas 3 NO llevan prefijo VITE_ a propósito: solo las usa el plugin de Vite
# en build-time (para subir source maps y crear el release), nunca llegan al
# bundle del navegador. Se generan en Sentry > Settings > Auth Tokens (scope
# "project:releases") y Settings > General del org/proyecto.
SENTRY_AUTH_TOKEN=
SENTRY_ORG=
SENTRY_PROJECT=

# Google AdSense (publicidad, fase 1: landing e invitación pública, ver
# src/components/ads/AdSlot.tsx) - requiere cuenta de AdSense aprobada,
# https://www.google.com/adsense/. VITE_ADSENSE_CLIENT_ID es el "ID de
# cliente" ("ca-pub-XXXXXXXXXXXXXXXX"), igual para todo el sitio. Cada
# VITE_ADSENSE_SLOT_* es el "ID de bloque de anuncios" de una unidad manual
# (nunca Auto ads) creada para ese placement específico en la consola de
# AdSense. Sin VITE_ADSENSE_CLIENT_ID, AdSlot no renderiza nada (ni el
# script, ni el espacio reservado) — y aunque exista el cliente, cada
# placement solo se activa si además tiene su propio slot configurado acá Y
# el placement está encendido en /admin (platformConfig/ads, ver AdsPanel).
VITE_ADSENSE_CLIENT_ID=
VITE_ADSENSE_SLOT_LANDING_BOTTOM=
VITE_ADSENSE_SLOT_INVITATION_BOTTOM=
